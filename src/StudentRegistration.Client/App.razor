<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <main id="application-root" tabindex="-1">
            <section class="srs-route-not-found" aria-labelledby="route-not-found-heading">
                <h1 id="route-not-found-heading">Page not found</h1>
                <p>The requested page is not available.</p>
                <a href="/student/login">Go to Student login</a>
            </section>
        </main>
    </NotFound>
</Router>
