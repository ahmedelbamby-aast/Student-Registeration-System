<section class="srs-schedule-calendar"
         role="region"
         aria-labelledby="@HeadingId"
         aria-describedby="@EquivalentListId"
         aria-live="polite"
         aria-busy="@IsLoading.ToString().ToLowerInvariant()"
         aria-disabled="@IsDisabled.ToString().ToLowerInvariant()"
         data-state="@StateName">
    <h2 id="@HeadingId">@Heading</h2>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="srs-schedule-calendar__error" role="alert">@ErrorMessage</p>
    }
    else if (IsLoading && !string.IsNullOrWhiteSpace(LoadingText))
    {
        <p class="srs-schedule-calendar__status" role="status">@LoadingText</p>
    }
    else if (Meetings.Count == 0)
    {
        @if (!string.IsNullOrWhiteSpace(EmptyText))
        {
            <p class="srs-schedule-calendar__empty">@EmptyText</p>
        }
    }
    else
    {
        @if (IsDisabled && !string.IsNullOrWhiteSpace(DisabledReason))
        {
            <p class="srs-schedule-calendar__disabled" data-disabled-reason>@DisabledReason</p>
        }

        <div class="srs-schedule-calendar__viewport" tabindex="0">
            <table aria-label="@Heading">
                <thead>
                    <tr>
                        <th scope="col">@DayColumnLabel</th>
                        <th scope="col">@TimeColumnLabel</th>
                        <th scope="col">@MeetingColumnLabel</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var meeting in Meetings)
                    {
                        <tr data-meeting-id="@meeting.MeetingId">
                            <td>@meeting.Day</td>
                            <td>
                                <time>@meeting.StartsAt - @meeting.EndsAt @meeting.Timezone</time>
                            </td>
                            <td>
                                @if (IsDisabled)
                                {
                                    <span class="srs-schedule-calendar__meeting"
                                          aria-label="@meeting.DetailsAccessibleName"
                                          aria-disabled="true">
                                        <strong>@meeting.SubjectCode @meeting.SubjectName</strong>
                                        <dl>
                                            <div><dt>@GroupLabel</dt><dd>@meeting.GroupCode</dd></div>
                                            <div><dt>@ActivityKindLabel</dt><dd>@meeting.ActivityKind</dd></div>
                                            @if (!string.IsNullOrWhiteSpace(meeting.LecturerName))
                                            {
                                                <div><dt>@LecturerLabel</dt><dd>@meeting.LecturerName</dd></div>
                                            }
                                            @if (meeting.TeachingAssistantNames.Count > 0)
                                            {
                                                <div>
                                                    <dt>@TeachingAssistantsLabel</dt>
                                                    <dd>@string.Join(", ", meeting.TeachingAssistantNames)</dd>
                                                </div>
                                            }
                                            <div><dt>@LocationLabel</dt><dd>@meeting.Location</dd></div>
                                            <div><dt>@ConflictLabel</dt><dd>@meeting.ConflictStatusText</dd></div>
                                        </dl>
                                    </span>
                                }
                                else
                                {
                                    <a class="srs-schedule-calendar__meeting"
                                       href="@meeting.DetailsHref"
                                       aria-label="@meeting.DetailsAccessibleName">
                                        <strong>@meeting.SubjectCode @meeting.SubjectName</strong>
                                        <dl>
                                            <div><dt>@GroupLabel</dt><dd>@meeting.GroupCode</dd></div>
                                            <div><dt>@ActivityKindLabel</dt><dd>@meeting.ActivityKind</dd></div>
                                            @if (!string.IsNullOrWhiteSpace(meeting.LecturerName))
                                            {
                                                <div><dt>@LecturerLabel</dt><dd>@meeting.LecturerName</dd></div>
                                            }
                                            @if (meeting.TeachingAssistantNames.Count > 0)
                                            {
                                                <div>
                                                    <dt>@TeachingAssistantsLabel</dt>
                                                    <dd>@string.Join(", ", meeting.TeachingAssistantNames)</dd>
                                                </div>
                                            }
                                            <div><dt>@LocationLabel</dt><dd>@meeting.Location</dd></div>
                                            <div><dt>@ConflictLabel</dt><dd>@meeting.ConflictStatusText</dd></div>
                                        </dl>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Heading { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string EquivalentListId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string DayColumnLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TimeColumnLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string MeetingColumnLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string GroupLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ActivityKindLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string LecturerLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TeachingAssistantsLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string LocationLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ConflictLabel { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ScheduleMeetingItem> Meetings { get; set; } = [];

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public string? DisabledReason { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? LoadingText { get; set; }

    [Parameter]
    public string? EmptyText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private string HeadingId => $"{EquivalentListId}-calendar-heading";

    private string StateName => !string.IsNullOrWhiteSpace(ErrorMessage)
        ? "error"
        : IsLoading
            ? "loading"
            : IsDisabled
                ? "disabled"
                : "default";

    public sealed record ScheduleMeetingItem(
        string MeetingId,
        string SubjectCode,
        string SubjectName,
        string GroupCode,
        string ActivityKind,
        string? LecturerName,
        IReadOnlyList<string> TeachingAssistantNames,
        string Location,
        string Day,
        string StartsAt,
        string EndsAt,
        string Timezone,
        string ConflictStatusText,
        string DetailsHref,
        string DetailsAccessibleName);
}
