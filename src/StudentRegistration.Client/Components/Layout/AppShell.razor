@using System.Globalization
@using StudentRegistration.Client.Features.Frontend.Models

<div class="srs-app-shell">
    <a class="srs-skip-link" href="#@MainContentId">@SkipLinkLabel</a>

    <header class="srs-app-shell__header" role="banner">
        @if (!string.IsNullOrWhiteSpace(BrandLogoSource))
        {
            <img class="srs-app-shell__logo"
                 src="@BrandLogoSource"
                 alt="@BrandLogoAccessibleName" />
        }

        @if (Context is not null && !IsLoading && Status is null)
        {
            <p class="srs-app-shell__identity">@Context.DisplayName</p>
            <dl class="srs-app-shell__context" aria-live="polite">
                <div>
                    <dt>@ServerDateTimeLabel</dt>
                    <dd>
                        <time data-context="server-time"
                              datetime="@Context.ServerDateTime.ToString("O")">
                            @Context.ServerDateTime.ToString("g", CultureInfo.CurrentCulture)
                        </time>
                        <span>@Context.TimeZone</span>
                    </dd>
                </div>
                <div>
                    <dt>@TeachingTermLabel</dt>
                    <dd>@Context.TeachingTerm</dd>
                </div>
                <div>
                    <dt>@RegistrationTermLabel</dt>
                    <dd>@Context.RegistrationTerm</dd>
                </div>
                <div>
                    <dt>@RegistrationWindowLabel</dt>
                    <dd>
                        <time datetime="@Context.RegistrationWindowOpensAt.ToString("O")">
                            @Context.RegistrationWindowOpensAt.ToString("g", CultureInfo.CurrentCulture)
                        </time>
                        <span aria-hidden="true">–</span>
                        <time datetime="@Context.RegistrationWindowClosesAt.ToString("O")">
                            @Context.RegistrationWindowClosesAt.ToString("g", CultureInfo.CurrentCulture)
                        </time>
                    </dd>
                </div>
                <div>
                    <dt>@AuthorizedRolesLabel</dt>
                    <dd>@string.Join(", ", Context.AuthorizedRoles)</dd>
                </div>
                <div>
                    <dt>@ActiveRoleLabel</dt>
                    <dd>@Context.ActiveRole</dd>
                </div>
                <div>
                    <dt>@SessionLabel</dt>
                    <dd>
                        <span>@Context.SessionState</span>
                        <time datetime="@Context.SessionExpiresAt.ToString("O")">
                            @Context.SessionExpiresAt.ToString("g", CultureInfo.CurrentCulture)
                        </time>
                    </dd>
                </div>
                <div>
                    <dt>@ServiceLabel</dt>
                    <dd>@Context.ServiceState</dd>
                </div>
            </dl>

            @Navigation
        }
    </header>

    <main id="@MainContentId" tabindex="-1">
        @if (IsLoading)
        {
            <section class="srs-app-shell__state srs-app-shell__state--loading"
                     data-state="loading"
                     role="status"
                     aria-busy="true">
                @LoadingLabel
            </section>
        }
        else if (Status is not null)
        {
            <section class="srs-app-shell__state srs-app-shell__state--@StatusState"
                     data-state="@StatusState"
                     role="@(Status.Severity is UiStatusSeverity.Error ? "alert" : "status")">
                <h1>@Status.Heading</h1>
                <p>@Status.Message</p>
                @if (!string.IsNullOrWhiteSpace(Status.ReferenceId))
                {
                    <p>@Status.ReferenceId</p>
                }
                @foreach (var action in Status.NextActions)
                {
                    <a href="@action.Target">@action.Label</a>
                }
            </section>
        }
        else if (Context is not null)
        {
            @ChildContent
        }
    </main>

    <footer class="srs-app-shell__footer" role="contentinfo">
        @if (Context is not null && !IsLoading && Status is null)
        {
            <a data-context="support" href="@Context.SupportReferencePath">
                @SupportLinkLabel
            </a>
        }
    </footer>
</div>

@code {
    [Parameter]
    public FrontendAppContextView? Context { get; set; }

    [Parameter]
    public UiStatus? Status { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string MainContentId { get; set; } = "main-content";

    [Parameter]
    public string SkipLinkLabel { get; set; } = string.Empty;

    [Parameter]
    public string BrandLogoSource { get; set; } = string.Empty;

    [Parameter]
    public string BrandLogoAccessibleName { get; set; } = string.Empty;

    [Parameter]
    public string ServerDateTimeLabel { get; set; } = string.Empty;

    [Parameter]
    public string TeachingTermLabel { get; set; } = string.Empty;

    [Parameter]
    public string RegistrationTermLabel { get; set; } = string.Empty;

    [Parameter]
    public string RegistrationWindowLabel { get; set; } = string.Empty;

    [Parameter]
    public string AuthorizedRolesLabel { get; set; } = string.Empty;

    [Parameter]
    public string ActiveRoleLabel { get; set; } = string.Empty;

    [Parameter]
    public string SessionLabel { get; set; } = string.Empty;

    [Parameter]
    public string ServiceLabel { get; set; } = string.Empty;

    [Parameter]
    public string SupportLinkLabel { get; set; } = string.Empty;

    [Parameter]
    public string LoadingLabel { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? Navigation { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string StatusState => Status?.Severity switch
    {
        UiStatusSeverity.Error => "error",
        UiStatusSeverity.Warning => "warning",
        UiStatusSeverity.Success => "success",
        _ => "information"
    };
}
