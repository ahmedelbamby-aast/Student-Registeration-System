@if (IsLoading)
{
    <section class="srs-validation-summary is-loading"
             id="@SummaryId"
             role="status"
             aria-busy="true"
             aria-labelledby="@HeadingId">
        <h2 id="@HeadingId">@Heading</h2>
        <p>@LoadingAnnouncement</p>
    </section>
}
else if (Errors.Count > 0)
{
    <section class="srs-validation-summary has-error"
             @ref="_summary"
             id="@SummaryId"
             role="alert"
             tabindex="-1"
             aria-labelledby="@HeadingId">
        <h2 id="@HeadingId">@Heading</h2>
        <ul>
            @foreach (var error in Errors)
            {
                <li><a href="#@error.ControlId">@error.Message</a></li>
            }
        </ul>
    </section>
}

@code {
    private ElementReference _summary;
    private bool _errorsFocused;
    private IReadOnlyList<ValidationItem>? _previousErrors;

    [Parameter]
    public string SummaryId { get; set; } = "validation-summary";

    [Parameter]
    public string Heading { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ValidationItem> Errors { get; set; } = Array.Empty<ValidationItem>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? LoadingAnnouncement { get; set; }

    private string HeadingId => $"{SummaryId}-heading";

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Errors);
        if (!ReferenceEquals(_previousErrors, Errors))
        {
            _previousErrors = Errors;
            _errorsFocused = false;
        }

        if (Errors.Count == 0 || IsLoading)
        {
            _errorsFocused = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsLoading && Errors.Count > 0 && !_errorsFocused)
        {
            _errorsFocused = true;
            await _summary.FocusAsync();
        }
    }

    public sealed record ValidationItem(string ControlId, string Message);
}
