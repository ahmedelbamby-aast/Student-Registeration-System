<div class="@CssClass"
     aria-busy="@(IsLoading ? "true" : null)">
    <label class="srs-form-field__label" for="@InputId">@Label</label>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="srs-form-field__description" id="@DescriptionId">@Description</p>
    }

    <input @attributes="AdditionalAttributes"
           class="srs-form-field__input"
           id="@InputId"
           name="@Name"
           type="@Type"
           value="@Value"
           placeholder="@(string.IsNullOrWhiteSpace(Placeholder) ? null : Placeholder)"
           autocomplete="@(string.IsNullOrWhiteSpace(Autocomplete) ? null : Autocomplete)"
           required="@Required"
           disabled="@IsUnavailable"
           aria-invalid="@(HasError ? "true" : null)"
           aria-describedby="@DescribedBy"
           @oninput="HandleInputAsync" />

    @if (HasError)
    {
        <p class="srs-form-field__error" id="@ErrorId">@ErrorMessage</p>
    }

    @if (IsLoading && !string.IsNullOrWhiteSpace(LoadingAnnouncement))
    {
        <p class="srs-form-field__status" role="status">@LoadingAnnouncement</p>
    }
</div>

@code {
    [Parameter]
    public string InputId { get; set; } = string.Empty;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Autocomplete { get; set; }

    [Parameter]
    public string? LoadingAnnouncement { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private bool HasDescription => !string.IsNullOrWhiteSpace(Description);

    private bool IsUnavailable => Disabled || IsLoading;

    private string DescriptionId => $"{InputId}-description";

    private string ErrorId => $"{InputId}-error";

    private string? DescribedBy =>
        (HasDescription, HasError) switch
        {
            (true, true) => $"{DescriptionId} {ErrorId}",
            (true, false) => DescriptionId,
            (false, true) => ErrorId,
            _ => null
        };

    private string CssClass =>
        $"srs-form-field{(Disabled ? " is-disabled" : string.Empty)}{(IsLoading ? " is-loading" : string.Empty)}{(HasError ? " has-error" : string.Empty)}";

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        if (!IsUnavailable)
        {
            await ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
        }
    }
}
