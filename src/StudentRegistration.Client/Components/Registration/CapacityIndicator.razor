<div class="srs-capacity-indicator"
     role="status"
     aria-label="@AccessibleName"
     aria-live="polite"
     aria-atomic="true"
     aria-busy="@IsLoading.ToString().ToLowerInvariant()"
     data-state="@StateName">
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="srs-capacity-indicator__error" role="alert">@ErrorMessage</p>
    }
    else if (IsLoading && !string.IsNullOrWhiteSpace(LoadingText))
    {
        <p class="srs-capacity-indicator__loading" data-loading>@LoadingText</p>
    }
    else
    {
        <dl class="srs-capacity-indicator__values">
            <div>
                <dt>@OccupiedLabel</dt>
                <dd>@Occupied</dd>
            </div>
            <div>
                <dt>@TotalLabel</dt>
                <dd>@Total</dd>
            </div>
            <div>
                <dt>@RemainingLabel</dt>
                <dd>@Remaining</dd>
            </div>
        </dl>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string AccessibleName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string OccupiedLabel { get; set; } = string.Empty;

    [Parameter]
    public int Occupied { get; set; }

    [Parameter, EditorRequired]
    public string TotalLabel { get; set; } = string.Empty;

    [Parameter]
    public int Total { get; set; }

    [Parameter, EditorRequired]
    public string RemainingLabel { get; set; } = string.Empty;

    [Parameter]
    public int Remaining { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? LoadingText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private string StateName => !string.IsNullOrWhiteSpace(ErrorMessage)
        ? "error"
        : IsLoading
            ? "loading"
            : "default";
}
