<div class="@CssClass"
     role="@LiveRole"
     aria-live="@LiveMode"
     aria-busy="@(IsLoading ? "true" : null)"
     aria-disabled="@(IsDisabled ? "true" : null)"
     data-state="@StateName">
    <span class="srs-alert__message">@EffectiveMessage</span>
    @if (IsDismissible)
    {
        <button type="button"
                class="srs-alert__dismiss"
                disabled="@(IsDisabled || IsLoading)"
                @onclick="OnDismiss">@DismissLabel</button>
    }
</div>

@code {
    public enum AlertUrgency
    {
        Polite,
        Assertive
    }

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public AlertUrgency Urgency { get; set; } = AlertUrgency.Polite;

    [Parameter]
    public bool IsDismissible { get; set; }

    [Parameter]
    public string? DismissLabel { get; set; }

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? LoadingMessage { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private string EffectiveMessage => HasError
        ? ErrorMessage!
        : IsLoading
            ? LoadingMessage!
            : Message;

    private string StateName => HasError
        ? "error"
        : IsLoading
            ? "loading"
            : IsDisabled
                ? "disabled"
                : "default";

    private string CssClass => $"srs-alert srs-alert--{StateName}";

    private string LiveRole => HasError || Urgency == AlertUrgency.Assertive
        ? "alert"
        : "status";

    private string LiveMode => HasError || Urgency == AlertUrgency.Assertive
        ? "assertive"
        : "polite";

    protected override void OnParametersSet()
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(Message);

        if (IsDismissible)
        {
            ArgumentException.ThrowIfNullOrWhiteSpace(DismissLabel);
        }

        if (IsLoading)
        {
            ArgumentException.ThrowIfNullOrWhiteSpace(LoadingMessage);
        }
    }
}
