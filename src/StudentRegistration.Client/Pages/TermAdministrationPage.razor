    };

    private static string WindowLifecycleLabel(RegistrationWindowLifecycle lifecycle) => lifecycle switch
    {
        RegistrationWindowLifecycle.Draft => LocalizedUiText.Get("Draft"),
        RegistrationWindowLifecycle.Published => LocalizedUiText.Get("Published"),
        RegistrationWindowLifecycle.EmergencyClosed => LocalizedUiText.Get("Emergency closed"),
        RegistrationWindowLifecycle.Superseded => LocalizedUiText.Get("Superseded"),
        _ => LocalizedUiText.Get("Unknown")
    };

    private static string ScopeLabel(RegistrationWindowScope scope) => scope switch
    {
        RegistrationWindowScope.AllStudents => LocalizedUiText.Get("All students"),
        RegistrationWindowScope.Program => LocalizedUiText.Get("Program"),
        RegistrationWindowScope.Cohort => LocalizedUiText.Get("Cohort"),
