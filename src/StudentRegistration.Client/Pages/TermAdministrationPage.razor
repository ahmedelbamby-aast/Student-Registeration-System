    private static string PublishWindowLabel(AdminRegistrationWindowDto window) =>
        LocalizedUiText.Format("{0} — {1}", WindowScopeLabel(window), UtcRangeLabel(window.OpensAtUtc, window.ClosesAtUtc));

    private sealed record ValidationIssue(string ControlId, string Message);

    private sealed record ChangedField(string Label, string ServerValue);

    private sealed class TermEditorModel
    {
        public string Code { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = "Africa/Cairo";
        public string TeachingStartsOn { get; set; } = string.Empty;
        public string TeachingEndsOn { get; set; } = string.Empty;
        public TermState State { get; set; } = TermState.Draft;
        public string Reason { get; set; } = string.Empty;
        public string Source { get; set; } = LocalizedUiText.Get("ADM-02 web administration");
        public List<WindowEditorModel> Windows { get; } = [];

        public static TermEditorModel New() => new();

        public static TermEditorModel From(AdminTermDto term)
        {
            var model = new TermEditorModel
            {
                Code = term.Code,
                DisplayName = term.DisplayName,
                TimeZoneId = term.TimeZoneId,
                TeachingStartsOn = DateValue(term.TeachingStartsOn),
                TeachingEndsOn = DateValue(term.TeachingEndsOn),
                State = term.State,
                Source = LocalizedUiText.Get("ADM-02 web administration")
            };
            model.Windows.AddRange(term.Windows.Select(window => WindowEditorModel.From(window, term.TimeZoneId)));
            return model;
        }
    }

    private sealed class WindowEditorModel
    {
        public Guid ClientKey { get; init; } = Guid.NewGuid();
        public string? Id { get; init; }
        public RegistrationWindowScope ScopeType { get; set; } = RegistrationWindowScope.AllStudents;
        public string? ScopeValue { get; set; }
        public string OpensAtLocal { get; set; } = string.Empty;
        public string ClosesAtLocal { get; set; } = string.Empty;
        public RegistrationWindowLifecycle LifecycleState { get; set; } = RegistrationWindowLifecycle.Draft;
        public bool HasImmutablePublishedValues => LifecycleState is RegistrationWindowLifecycle.Published;

        public static WindowEditorModel New() => new();

        public static WindowEditorModel From(AdminRegistrationWindowDto window, string timeZoneId)
        {
            var timeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
            return new WindowEditorModel
            {
                Id = window.Id,
                ScopeType = window.ScopeType,
                ScopeValue = window.ScopeValue,
                OpensAtLocal = LocalInputValue(window.OpensAtUtc, timeZone),
                ClosesAtLocal = LocalInputValue(window.ClosesAtUtc, timeZone),
                LifecycleState = window.LifecycleState
            };
        }

        private static string LocalInputValue(DateTime utc, TimeZoneInfo timeZone)
        {
            var normalizedUtc = utc.Kind is DateTimeKind.Utc
                ? utc
                : DateTime.SpecifyKind(utc, DateTimeKind.Utc);
            return TimeZoneInfo.ConvertTimeFromUtc(normalizedUtc, timeZone)
                .ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }
    }
}
