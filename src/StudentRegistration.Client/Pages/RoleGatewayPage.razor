@page "/"
@using System.Globalization
@using StudentRegistration.Client.Components.Display
@using StudentRegistration.Client.Features.Academics
@using StudentRegistration.Client.UX
@inject AcademicApiClient AcademicApi

<PageTitle>@LocalizedUiText.Get("Role gateway | Student Registration")</PageTitle>

<div class="srs-public-gateway" data-route-id="AUTH-01" data-state="@StateToken">
    <a class="srs-skip-link" href="#main-content">@LocalizedUiText.Get("Skip to main content")</a>

    <header class="srs-public-gateway__header" role="banner">
        <a class="srs-public-gateway__brand" href="/" aria-label="@(LocalizedUiText.Get("Student Registration home"))">
            <img src="/brand/aastmt-logo.png"
                 alt="@(LocalizedUiText.Get("Arab Academy for Science, Technology and Maritime Transport"))" />
            <span>
                <strong>@LocalizedUiText.Get("AASTMT")</strong>
                <small>@LocalizedUiText.Get("Student Registration")</small>
            </span>
        </a>
        <span class="srs-public-gateway__demo-label">@LocalizedUiText.Get("Academic services demo")</span>
    </header>

    <main id="main-content"
          class="srs-public-gateway__main"
          data-testid="role-gateway-page"
          tabindex="-1">
        <section class="srs-public-gateway__intro" aria-labelledby="role-gateway-heading">
            <p class="srs-public-gateway__eyebrow">@LocalizedUiText.Get("Online academic services")</p>
            <h1 id="role-gateway-heading" tabindex="-1">@LocalizedUiText.Get("Role gateway")</h1>
            <p>
                @LocalizedUiText.Get("Check the server-authoritative academic status, then choose the correct secure access path.")
            </p>
        </section>

        @if (_isLoading)
        {
            <section class="srs-public-context srs-public-context--loading"
                     data-testid="public-context-loading"
                     data-contract-state="AUTH-01-COMP-STATE-LOADING"
                     role="status"
                     aria-live="polite"
                     aria-busy="true">
                <span class="srs-public-context__pulse" aria-hidden="true"></span>
                <div>
                    <h2>@LocalizedUiText.Get("Loading public academic status")</h2>
                    <p>@LocalizedUiText.Get("Checking the current term and registration service once.")</p>
                </div>
            </section>
        }
        else if (_state is RouteUiState.Success && _context is not null)
        {
            <section class="srs-public-context"
                     aria-labelledby="public-context-heading"
                     data-contract-state="AUTH-01-COMP-STATE-SUCCESS"
                     aria-live="polite">
                <div class="srs-public-context__heading">
                    <div>
                        <p class="srs-public-gateway__eyebrow">@LocalizedUiText.Get("Current server status")</p>
                        <h2 id="public-context-heading">@LocalizedUiText.Get("Academic context")</h2>
                    </div>
                    <StatusBadge Text="@(LocalizedUiText.Get("Available"))"
                                 Tone="StatusBadge.BadgeTone.Success" />
                </div>

                <dl class="srs-public-context__facts">
                    <div>
                        <dt>@LocalizedUiText.Get("Server time")</dt>
                        <dd>
                            <time datetime="@UtcInstant(_context.ServerTimeUtc)">
                                @ServerTimeLabel(_context.ServerTimeUtc)
                            </time>
                            <span>@_context.TimeZoneId</span>
                        </dd>
                    </div>
                    <div>
                        <dt>@LocalizedUiText.Get("Teaching term")</dt>
                        <dd>@(_context.TeachingTermLabel ?? "No teaching term published")</dd>
                    </div>
                    <div>
                        <dt>@LocalizedUiText.Get("Registration term")</dt>
                        <dd>@(_context.RegistrationTermLabel ?? "No registration term published")</dd>
                    </div>
                    <div>
                        <dt>@LocalizedUiText.Get("Registration window")</dt>
                        <dd>
                            <StatusBadge Text="@WindowLabel(_context.RegistrationWindowState)"
                                         Tone="@WindowTone(_context.RegistrationWindowState)" />
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="srs-public-gateway__destinations" aria-label="@(LocalizedUiText.Get("Sign-in destinations"))">
                <EntityCard HeadingId="student-destination-heading" Heading="@(LocalizedUiText.Get("Students"))">
                    <ChildContent>
                        <p>
                            @LocalizedUiText.Get("Sign in with your University ID, or activate a generated demo account for first use.")
                        </p>
                    </ChildContent>
                    <Actions>
                        <div class="srs-public-gateway__card-actions">
                            <a class="srs-public-gateway__primary-link"
                               data-testid="student-login-link"
                               href="/student/login">@LocalizedUiText.Get("Student login")</a>
                            <a class="srs-public-gateway__secondary-link"
                               data-testid="student-activation-link"
                               href="/student/activate">@LocalizedUiText.Get("Student activation")</a>
                        </div>
                    </Actions>
                </EntityCard>

                <EntityCard HeadingId="staff-destination-heading" Heading="@(LocalizedUiText.Get("Academic staff"))">
                    <ChildContent>
                        <p>
                            @LocalizedUiText.Get("Admins, Lecturers, and Teaching Assistants use the shared staff sign-in page. The server assigns authorized access.")
                        </p>
                    </ChildContent>
                    <Actions>
                        <div class="srs-public-gateway__card-actions">
                            <a class="srs-public-gateway__primary-link"
                               data-testid="staff-login-link"
                               href="/staff/login">@LocalizedUiText.Get("Staff login")</a>
                        </div>
                    </Actions>
                </EntityCard>
            </section>
        }
        else if (_state is RouteUiState.Stale)
        {
            <section class="srs-public-context srs-public-context--warning"
                     data-contract-state="AUTH-01-COMP-STATE-STALE"
                     aria-labelledby="public-context-stale-heading"
                     aria-live="polite">
                <h2 id="public-context-stale-heading">@LocalizedUiText.Get("Public status changed")</h2>
                <p class="srs-public-context__code">@_reasonCode</p>
                <p>@_safeMessage</p>
                @RecoveryActions()
            </section>
        }
        else if (_state is RouteUiState.Offline)
        {
            <section class="srs-public-context srs-public-context--warning"
                     data-contract-state="AUTH-01-COMP-STATE-OFFLINE"
                     aria-labelledby="public-context-offline-heading"
                     aria-live="polite">
                <h2 id="public-context-offline-heading">@LocalizedUiText.Get("Offline Role gateway status")</h2>
                <p>@_safeMessage</p>
                @RecoveryActions()
            </section>
        }
        else
        {
            <section class="srs-public-context srs-public-context--error"
                     data-contract-state="AUTH-01-COMP-STATE-SERVICE-ERROR"
                     aria-labelledby="public-context-error-heading"
                     aria-live="polite">
                <h2 id="public-context-error-heading">@LocalizedUiText.Get("Public academic status unavailable")</h2>
                <p class="srs-public-context__code">@_reasonCode</p>
                <p>@_safeMessage</p>
                @RecoveryActions()
            </section>
        }
    </main>

    <footer class="srs-public-gateway__footer" role="contentinfo">
        <p>@LocalizedUiText.Get("Arab Academy for Science, Technology and Maritime Transport")</p>
        <a href="/status/support">@LocalizedUiText.Get("System status and support")</a>
    </footer>
</div>

@code {
    private const string ServiceUnavailable = "SERVICE_UNAVAILABLE";
    private const string Maintenance = "MAINTENANCE";
    private const string WindowChanged = "WINDOW_CHANGED";

    private PublicContextDto? _context;
    private RouteUiState _state = RouteUiState.Loading;
    private bool _isLoading = true;
    private bool _isRetrying;
    private string _reasonCode = ServiceUnavailable;
    private string _safeMessage = LocalizedUiText.Get("Public context could not be loaded.");
    private string? _referenceId;

    private string StateToken => _isLoading
        ? "loading"
        : _state.ToString().ToLowerInvariant();

    protected override Task OnInitializedAsync() => LoadPublicContextAsync();

    private async Task RetryPublicContextAsync()
    {
        if (_isRetrying)
        {
            return;
        }

        _isRetrying = true;
        try
        {
            await LoadPublicContextAsync();
        }
        finally
        {
            _isRetrying = false;
        }
    }

    private async Task LoadPublicContextAsync()
    {
        _isLoading = true;
        _context = null;
        try
        {
            var result = await AcademicApi.GetPublicContextAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                ApplyContext(result.Value);
                return;
            }

            ApplyFailure(result.Error);
        }
        catch (HttpRequestException)
        {
            _state = RouteUiState.Offline;
            _reasonCode = "OFFLINE";
            _safeMessage = LocalizedUiText.Get("The browser cannot reach the service. Reconnect and retry public context.");
            _referenceId = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyContext(PublicContextDto context)
    {
        _referenceId = null;
        switch (context.ServiceState)
        {
            case ServiceState.Available:
                _context = context;
                _state = RouteUiState.Success;
                _reasonCode = "AVAILABLE";
        _safeMessage = LocalizedUiText.Get("Public academic status is available.");
                break;
            case ServiceState.Maintenance:
                _state = RouteUiState.ServiceError;
                _reasonCode = Maintenance;
        _safeMessage = LocalizedUiText.Get("Public registration status is temporarily unavailable.");
                break;
            default:
                _state = RouteUiState.ServiceError;
                _reasonCode = ServiceUnavailable;
                _safeMessage = LocalizedUiText.Get("Public context could not be loaded.");
                break;
        }
    }

    private void ApplyFailure(ApiError? error)
    {
        _reasonCode = error?.Code ?? ServiceUnavailable;
        _safeMessage = error?.Message ?? LocalizedUiText.Get("Public context could not be loaded.");
        _referenceId = error?.CorrelationId;
        _state = string.Equals(_reasonCode, WindowChanged, StringComparison.Ordinal)
            ? RouteUiState.Stale
            : RouteUiState.ServiceError;
    }

    private RenderFragment RecoveryActions() => @<div class="srs-public-context__recovery">
        @if (!string.IsNullOrWhiteSpace(_referenceId))
        {
            <p class="srs-public-context__reference">
                @LocalizedUiText.Get("Reference") <strong>@_referenceId</strong>
            </p>
        }
        <div class="srs-public-context__actions">
            <button type="button"
                    data-testid="public-context-retry"
                    disabled="@_isRetrying"
                    @onclick="RetryPublicContextAsync">
                @(_isRetrying ? "Retrying…" : LocalizedUiText.Get("Retry public context"))
            </button>
            <a href="/status/support">@LocalizedUiText.Get("Open safe support path")</a>
        </div>
    </div>;

    private static string UtcInstant(DateTime value) =>
        value.ToString("O", CultureInfo.InvariantCulture);

    private static string ServerTimeLabel(DateTime value) =>
        value.ToString("g", CultureInfo.CurrentCulture);

    private static string WindowLabel(RegistrationWindowState state) => state switch
    {
        RegistrationWindowState.Open => LocalizedUiText.Get("Open"),
        RegistrationWindowState.Upcoming => LocalizedUiText.Get("Upcoming"),
        RegistrationWindowState.Closed => LocalizedUiText.Get("Closed"),
        _ => LocalizedUiText.Get("No registration window")
    };

    private static StatusBadge.BadgeTone WindowTone(RegistrationWindowState state) => state switch
    {
        RegistrationWindowState.Open => StatusBadge.BadgeTone.Success,
        RegistrationWindowState.Upcoming => StatusBadge.BadgeTone.Information,
        RegistrationWindowState.Closed => StatusBadge.BadgeTone.Warning,
        _ => StatusBadge.BadgeTone.Neutral
    };
}
