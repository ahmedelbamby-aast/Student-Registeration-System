@page "/admin/registrations"

<PageTitle>@LocalizedUiText.Get("Registration monitoring | Student Registration")</PageTitle>

<div class="srs-registration-monitor"
     data-route-id="ADM-08"
     data-state="loading"
     data-supported-states="loading empty success stale degraded unauthorized session-expired offline">
    <a class="srs-registration-monitor__skip" href="#main-content">@LocalizedUiText.Get("Skip to main content")</a>

    <header class="srs-registration-monitor__header" role="banner">
        <a href="/admin" aria-label="@(LocalizedUiText.Get("Administration home"))">
            <strong>@LocalizedUiText.Get("AASTMT")</strong>
            <span>@LocalizedUiText.Get("Student Registration")</span>
        </a>
        <nav aria-label="@(LocalizedUiText.Get("Administration navigation"))">
            <a href="/admin">@LocalizedUiText.Get("Dashboard")</a>
            <a href="/admin/registrations" aria-current="page">@LocalizedUiText.Get("Registrations")</a>
            <a href="/admin/audit">@LocalizedUiText.Get("Audit")</a>
        </nav>
    </header>

    <main id="main-content" tabindex="-1">
        <section class="srs-registration-monitor__intro" aria-labelledby="registration-monitor-heading">
            <p class="srs-registration-monitor__eyebrow">@LocalizedUiText.Get("Operations and reconciliation")</p>
            <h1 id="registration-monitor-heading">@LocalizedUiText.Get("Read-only registration monitoring")</h1>
            <p>
                @LocalizedUiText.Get("Inspect server-authorized submission, receipt, fill, failure, and reconciliation observations without changing registration state.")
            </p>
        </section>

        <section class="srs-registration-monitor__state"
                 role="status"
                 aria-live="polite"
                 aria-busy="true">
            <h2>@LocalizedUiText.Get("Loading registration observations")</h2>
            <p>
                @LocalizedUiText.Get("Metrics and registration records have not been loaded. No live, successful, or repaired state is inferred in the browser.")
            </p>
        </section>

        <section class="srs-registration-monitor__metrics" aria-labelledby="registration-metrics-heading">
            <div>
                <h2 id="registration-metrics-heading">@LocalizedUiText.Get("Operations metrics")</h2>
                <p>
                    @LocalizedUiText.Get("Observation time:")
                    <time data-testid="registration-monitor-observed-at">@LocalizedUiText.Get("Awaiting server observation")</time>
                </p>
            </div>
            <dl>
                <div><dt>@LocalizedUiText.Get("Submissions")</dt><dd>@LocalizedUiText.Get("Not loaded")</dd></div>
                <div><dt>@LocalizedUiText.Get("Fill")</dt><dd>@LocalizedUiText.Get("Not loaded")</dd></div>
                <div><dt>@LocalizedUiText.Get("Failures")</dt><dd>@LocalizedUiText.Get("Not loaded")</dd></div>
                <div><dt>@LocalizedUiText.Get("Collisions")</dt><dd>@LocalizedUiText.Get("Not loaded")</dd></div>
            </dl>
            <button type="button" disabled>@LocalizedUiText.Get("Refresh monitoring data")</button>
        </section>

        <section class="srs-registration-monitor__filters" aria-labelledby="registration-filter-heading">
            <h2 id="registration-filter-heading">@LocalizedUiText.Get("Registration filters")</h2>
            <form aria-label="@(LocalizedUiText.Get("Registration monitoring filters"))">
                <label>
                    @LocalizedUiText.Get("Student or submission")
                    <input type="search" name="query" maxlength="100" />
                </label>
                <label>
                    @LocalizedUiText.Get("Result")
                    <select name="result">
                        <option value="">@LocalizedUiText.Get("All results")</option>
                        <option value="accepted">@LocalizedUiText.Get("Accepted")</option>
                        <option value="rejected">@LocalizedUiText.Get("Rejected")</option>
                    </select>
                </label>
                <button type="button" disabled>@LocalizedUiText.Get("Filter registrations")</button>
                <button type="reset">@LocalizedUiText.Get("Clear registration filters")</button>
            </form>
        </section>

        <div class="srs-registration-monitor__workspace">
            <section aria-labelledby="registration-results-heading">
                <h2 id="registration-results-heading">@LocalizedUiText.Get("Submission and fill results")</h2>
                <div class="srs-registration-monitor__table-region"
                     role="region"
                     aria-label="@(LocalizedUiText.Get("Registration monitoring results"))"
                     tabindex="0">
                    <table data-testid="registration-monitor-table">
                        <caption>@LocalizedUiText.Get("No server-authorized registration rows are loaded.")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@LocalizedUiText.Get("Submitted")</th>
                                <th scope="col">@LocalizedUiText.Get("Student")</th>
                                <th scope="col">@LocalizedUiText.Get("Receipt")</th>
                                <th scope="col">@LocalizedUiText.Get("Result")</th>
                                <th scope="col">@LocalizedUiText.Get("Action")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5">@LocalizedUiText.Get("No matching registrations are loaded.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="srs-registration-monitor__semantic-alternative"
                     data-testid="registration-monitor-card-list"
                     aria-label="@(LocalizedUiText.Get("Registration results semantic alternative"))">
                    <h3>@LocalizedUiText.Get("Registration result summaries")</h3>
                    <p>@LocalizedUiText.Get("No matching registrations are loaded.")</p>
                </div>

                <nav class="srs-registration-monitor__pagination" aria-label="@(LocalizedUiText.Get("Registration result pages"))">
                    <button type="button" disabled>@LocalizedUiText.Get("Previous page")</button>
                    <span>@LocalizedUiText.Get("Page 1 of 1")</span>
                    <button type="button" disabled>@LocalizedUiText.Get("Next page")</button>
                </nav>
            </section>

            <aside class="srs-registration-monitor__detail" aria-labelledby="receipt-detail-heading">
                <h2 id="receipt-detail-heading">@LocalizedUiText.Get("Selected receipt detail")</h2>
                <p>@LocalizedUiText.Get("Open a server-authorized submission to inspect its immutable receipt summary.")</p>
                <button type="button" disabled>@LocalizedUiText.Get("Open submission detail")</button>
                <button type="button" disabled>@LocalizedUiText.Get("Open Student profile")</button>
            </aside>
        </div>

        <section class="srs-registration-monitor__alerts" aria-labelledby="reconciliation-alert-heading">
            <h2 id="reconciliation-alert-heading">@LocalizedUiText.Get("Reconciliation alerts")</h2>
            <p>@LocalizedUiText.Get("No collision, paused-group, repaired, stale, or degraded observation is loaded.")</p>
            <p>
                @LocalizedUiText.Get("A server alert keeps its detected timestamp, affected group, state, and") <code>@LocalizedUiText.Get("supportReferencePath")</code> @LocalizedUiText.Get("together.")
            </p>
            <a href="/status/support">@LocalizedUiText.Get("Open safe support reference")</a>
        </section>

        <section class="srs-registration-monitor__notice" role="note">
            <h2>@LocalizedUiText.Get("Observation only")</h2>
            <p>
                @LocalizedUiText.Get("No repair or correction actions are available. Capacity, enrollment, receipt, and reconciliation decisions remain with their server owners.")
            </p>
        </section>
    </main>

    <footer>
        <a href="/status/support">@LocalizedUiText.Get("Open safe support reference")</a>
    </footer>
</div>
