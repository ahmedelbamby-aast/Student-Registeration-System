@page "/admin/audit"

<PageTitle>@LocalizedUiText.Get("Audit administration | Student Registration")</PageTitle>

<div class="srs-audit-admin"
     data-route-id="ADM-09"
     data-state="loading"
     data-supported-states="loading empty success validation-error service-error unauthorized session-expired stale offline queued ready failed expired restricted">
    <a class="srs-audit-admin__skip" href="#main-content">@LocalizedUiText.Get("Skip to main content")</a>

    <header class="srs-audit-admin__header" role="banner">
        <a href="/admin" aria-label="@(LocalizedUiText.Get("Administration home"))">
            <strong>@LocalizedUiText.Get("AASTMT")</strong>
            <span>@LocalizedUiText.Get("Student Registration")</span>
        </a>
        <nav aria-label="@(LocalizedUiText.Get("Administration navigation"))">
            <a href="/admin">@LocalizedUiText.Get("Dashboard")</a>
            <a href="/admin/registrations">@LocalizedUiText.Get("Registrations")</a>
            <a href="/admin/audit" aria-current="page">@LocalizedUiText.Get("Audit")</a>
        </nav>
    </header>

    <main id="main-content" tabindex="-1">
        <section class="srs-audit-admin__intro" aria-labelledby="audit-administration-heading">
            <p class="srs-audit-admin__eyebrow">@LocalizedUiText.Get("Immutable administrative evidence")</p>
            <h1 id="audit-administration-heading">@LocalizedUiText.Get("Scoped audit search")</h1>
            <p>
                @LocalizedUiText.Get("Search only events visible in the current server scope and follow an asynchronous, expiring export lifecycle.")
            </p>
        </section>

        <section class="srs-audit-admin__state"
                 role="status"
                 aria-live="polite"
                 aria-busy="true">
            <h2>@LocalizedUiText.Get("Loading audit events")</h2>
            <p>@LocalizedUiText.Get("No scoped event or export result has been accepted by the server.")</p>
        </section>

        <section class="srs-audit-admin__filters" aria-labelledby="audit-filter-heading">
            <h2 id="audit-filter-heading">@LocalizedUiText.Get("Scope and search filters")</h2>
            <form role="search" aria-label="@(LocalizedUiText.Get("Scoped audit filters"))">
                <label>
                    @LocalizedUiText.Get("Actor")
                    <input type="search" name="actorId" maxlength="100" />
                </label>
                <label>
                    @LocalizedUiText.Get("Action")
                    <input type="search" name="action" maxlength="100" />
                </label>
                <label>
                    @LocalizedUiText.Get("Source")
                    <select name="sourceStream">
                        <option value="">@LocalizedUiText.Get("All authorized sources")</option>
                        <option value="audit">@LocalizedUiText.Get("Audit")</option>
                        <option value="identity-security">@LocalizedUiText.Get("Identity security")</option>
                    </select>
                </label>
                <label>
                    @LocalizedUiText.Get("Page size")
                    <input type="number" name="pageSize" min="1" max="100" value="20" />
                </label>
                <button type="button" disabled>@LocalizedUiText.Get("Search audit")</button>
                <button type="reset">@LocalizedUiText.Get("Clear filters")</button>
            </form>
        </section>

        <div class="srs-audit-admin__workspace">
            <section aria-labelledby="audit-results-heading">
                <h2 id="audit-results-heading">@LocalizedUiText.Get("Paged immutable events")</h2>
                <div class="srs-audit-admin__table-region"
                     role="region"
                     aria-label="@(LocalizedUiText.Get("Scoped audit results"))"
                     tabindex="0">
                    <table data-testid="audit-event-table">
                        <caption>@LocalizedUiText.Get("No server-authorized audit rows are loaded.")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@LocalizedUiText.Get("Occurred")</th>
                                <th scope="col">@LocalizedUiText.Get("Actor")</th>
                                <th scope="col">@LocalizedUiText.Get("Action")</th>
                                <th scope="col">@LocalizedUiText.Get("Target")</th>
                                <th scope="col">@LocalizedUiText.Get("Correlation")</th>
                                <th scope="col">@LocalizedUiText.Get("Action")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="6">@LocalizedUiText.Get("No audit events match the current authorized filters.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="srs-audit-admin__semantic-alternative"
                     data-testid="audit-event-card-list"
                     aria-label="@(LocalizedUiText.Get("Audit results semantic alternative"))">
                    <h3>@LocalizedUiText.Get("Audit event summaries")</h3>
                    <p>@LocalizedUiText.Get("No audit events match the current authorized filters.")</p>
                </div>

                <nav class="srs-audit-admin__pagination" aria-label="@(LocalizedUiText.Get("Audit result pages"))">
                    <button type="button" disabled>@LocalizedUiText.Get("Previous page")</button>
                    <span>@LocalizedUiText.Get("Page 1 of 1")</span>
                    <button type="button" disabled>@LocalizedUiText.Get("Next page")</button>
                </nav>
            </section>

            <aside class="srs-audit-admin__detail" aria-labelledby="immutable-event-detail-heading">
                <h2 id="immutable-event-detail-heading">@LocalizedUiText.Get("Immutable event detail")</h2>
                <p>@LocalizedUiText.Get("Select an authorized event to view its redacted before and after summaries.")</p>
                <dl>
                    <div><dt>@LocalizedUiText.Get("Actor")</dt><dd>@LocalizedUiText.Get("Not selected")</dd></div>
                    <div><dt>@LocalizedUiText.Get("Reason")</dt><dd>@LocalizedUiText.Get("Not selected")</dd></div>
                    <div><dt>@LocalizedUiText.Get("Correlation")</dt><dd>@LocalizedUiText.Get("Not selected")</dd></div>
                    <div><dt>@LocalizedUiText.Get("Source")</dt><dd>@LocalizedUiText.Get("Not selected")</dd></div>
                </dl>
                <button type="button" disabled>@LocalizedUiText.Get("Open event detail")</button>
            </aside>
        </div>

        <section class="srs-audit-admin__export" aria-labelledby="export-lifecycle-heading">
            <div>
                <h2 id="export-lifecycle-heading">@LocalizedUiText.Get("Scoped export lifecycle")</h2>
                <p>
                    @LocalizedUiText.Get("Export status may be queued, ready, failed, or expired. Restricted jobs reveal no event or job detail.")
                </p>
            </div>
            <dl>
                <div><dt>@LocalizedUiText.Get("Job")</dt><dd>@LocalizedUiText.Get("Not requested")</dd></div>
                <div><dt>@LocalizedUiText.Get("Status")</dt><dd>@LocalizedUiText.Get("Not loaded")</dd></div>
                <div><dt>@LocalizedUiText.Get("Expiry")</dt><dd>@LocalizedUiText.Get("Not loaded")</dd></div>
            </dl>
            <div class="srs-audit-admin__actions">
                <button type="button" disabled>@LocalizedUiText.Get("Request export")</button>
                <button type="button" disabled>@LocalizedUiText.Get("Refresh export status")</button>
                <button type="button" disabled>@LocalizedUiText.Get("Download ready export")</button>
                <button type="button" disabled>@LocalizedUiText.Get("Request a new export")</button>
            </div>
            <p class="srs-audit-admin__authorization-note">
                @LocalizedUiText.Get("Only the server can authorize a scoped download. A ready status never broadens the current actor or row permissions.")
            </p>
        </section>
    </main>

    <footer>
        <a href="/status/support">@LocalizedUiText.Get("Open safe support")</a>
    </footer>
</div>
