@page "/admin/users"

<PageTitle>@LocalizedUiText.Get("User administration")</PageTitle>

<div class="srs-admin-users">
    <a class="srs-skip-link" href="#admin-users-main">@LocalizedUiText.Get("Skip to main content")</a>
    <header class="srs-admin-users__header">
        <img src="brand/aastmt-logo.png"
             alt="@(LocalizedUiText.Get("Arab Academy for Science, Technology and Maritime Transport"))" />
        <nav aria-label="@(LocalizedUiText.Get("Administration"))">
            <a href="/admin">@LocalizedUiText.Get("Admin dashboard")</a>
            <a href="/admin/users" aria-current="page">@LocalizedUiText.Get("Users")</a>
        </nav>
    </header>

    <main id="admin-users-main" tabindex="-1">
        <h1>@LocalizedUiText.Get("User administration")</h1>
        <p>@LocalizedUiText.Get("Search pre-provisioned identities, review imports, and submit governed account changes.")</p>

        <IdentityFeedback IsBusy="@IsBusy"
                          BusyMessage="@(LocalizedUiText.Get("Applying one identity operation."))"
                          IsError="@_feedbackIsError"
                          Heading="@_feedbackHeading"
                          Message="@_feedbackMessage"
                          State="@_feedbackState"
                          Code="@_feedbackCode"
                          CorrelationId="@_correlationId" />

        <section class="srs-admin-users__section" aria-labelledby="user-search-heading">
            <h2 id="user-search-heading">@LocalizedUiText.Get("Find users")</h2>
            <form class="srs-admin-users__search"
                  role="search"
                  aria-label="@(LocalizedUiText.Get("Search users"))"
                  @onsubmit="SearchAsync"
                  @onsubmit:preventDefault>
                <label for="admin-user-search">@LocalizedUiText.Get("Name or login identifier")</label>
                <input id="admin-user-search"
                       name="search"
                       type="search"
                       maxlength="200"
                       disabled="@IsBusy"
                       @bind="_search"
                       @bind:event="oninput" />
                <button type="submit" disabled="@IsBusy">@LocalizedUiText.Get("Search")</button>
                <button type="button" disabled="@IsBusy" @onclick="ClearSearchAsync">@LocalizedUiText.Get("Clear")</button>
            </form>

            <div class="srs-admin-users__table-region"
                 role="region"
                     aria-label="@(LocalizedUiText.Get("User results"))"
                 tabindex="0"
                 aria-busy="@(_isLoadingUsers ? "true" : null)">
                <table>
                    <caption>@_totalCount @LocalizedUiText.Get("user results; page") @_currentPage @LocalizedUiText.Get("of") @TotalPages</caption>
                    <thead>
                        <tr>
                            <th scope="col">@LocalizedUiText.Get("Name")</th>
                            <th scope="col">@LocalizedUiText.Get("Login")</th>
                            <th scope="col">@LocalizedUiText.Get("Status")</th>
                            <th scope="col">@LocalizedUiText.Get("Roles")</th>
                            <th scope="col">@LocalizedUiText.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingUsers)
                        {
                            <tr><td colspan="5"><span role="status">@LocalizedUiText.Get("Loading users…")</span></td></tr>
                        }
                        else if (_users.Count == 0)
                        {
                            <tr><td colspan="5">@LocalizedUiText.Get("No authorized users match this search.")</td></tr>
                        }
                        else
                        {
                            @foreach (var user in _users)
                            {
                                <tr class="@(user.Id == _selectedUser?.Id ? "is-selected" : null)">
                                    <td>@user.DisplayName</td>
                                    <td>@user.LoginIdentifier</td>
                                    <td>@(user.Enabled ? LocalizedUiText.Get("Enabled") : LocalizedUiText.Get("Disabled"))</td>
                                    <td>@DisplayRoles(user.Roles)</td>
                                    <td>
                                        <button type="button"
                                                disabled="@IsBusy"
                                                aria-pressed="@(user.Id == _selectedUser?.Id ? "true" : "false")"
                                                @onclick="() => SelectUser(user)">
                                            @LocalizedUiText.Get("Review")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (_users.Count > 0)
            {
                <ul class="srs-admin-users__cards" aria-label="@(LocalizedUiText.Get("User results, compact view"))">
                    @foreach (var user in _users)
                    {
                        <li>
                            <strong>@user.DisplayName</strong>
                            <span>@user.LoginIdentifier</span>
                            <span>@(user.Enabled ? LocalizedUiText.Get("Enabled") : LocalizedUiText.Get("Disabled"))</span>
                            <span>@DisplayRoles(user.Roles)</span>
                            <button type="button" disabled="@IsBusy" @onclick="() => SelectUser(user)">
                                @LocalizedUiText.Get("Review")
                            </button>
                        </li>
                    }
                </ul>
            }

            <nav class="srs-admin-users__pagination" aria-label="@(LocalizedUiText.Get("User result pages"))">
                <button type="button"
                        disabled="@(IsBusy || _currentPage <= 1)"
                        @onclick="() => ChangePageAsync(_currentPage - 1)">
                    @LocalizedUiText.Get("Previous")
                </button>
                <span aria-live="polite">@LocalizedUiText.Get("Page") @_currentPage @LocalizedUiText.Get("of") @TotalPages</span>
                <button type="button"
                        disabled="@(IsBusy || _currentPage >= TotalPages)"
                        @onclick="() => ChangePageAsync(_currentPage + 1)">
                    @LocalizedUiText.Get("Next")
                </button>
            </nav>
        </section>

        @if (_selectedUser is not null)
        {
            <section class="srs-admin-users__section"
                     aria-labelledby="selected-user-heading"
                     data-concurrency-token="expectedRowVersion">
                <h2 id="selected-user-heading">@LocalizedUiText.Get("Review") @_selectedUser.DisplayName</h2>
                <dl class="srs-admin-users__details">
                    <div><dt>@LocalizedUiText.Get("Login")</dt><dd>@_selectedUser.LoginIdentifier</dd></div>
                    <div><dt>@LocalizedUiText.Get("Status")</dt><dd>@(_selectedUser.Enabled ? LocalizedUiText.Get("Enabled") : LocalizedUiText.Get("Disabled"))</dd></div>
                    <div><dt>@LocalizedUiText.Get("Roles")</dt><dd>@DisplayRoles(_selectedUser.Roles)</dd></div>
                </dl>

                <AccessibleValidationSummary SummaryId="user-status-errors"
                                             Heading="@(LocalizedUiText.Get("Review the account status change"))"
                                             Errors="@_statusErrors" />
                <div class="srs-admin-users__editor">
                    <label for="status-change-reason">@LocalizedUiText.Get("Reason for status change")</label>
                    <textarea id="status-change-reason"
                              maxlength="1000"
                              disabled="@IsBusy"
                              @bind="_statusReason"
                              @bind:event="oninput"></textarea>
                    <button @ref="_statusChangeButton"
                            type="button"
                            disabled="@IsBusy"
                            @onclick="OpenStatusConfirmation">
                        @(_selectedUser.Enabled ? LocalizedUiText.Get("Disable account") : LocalizedUiText.Get("Enable account"))
                    </button>
                </div>

                @if (!IsStudentIdentity)
                {
                    <form class="srs-admin-users__editor"
                          @onsubmit="ReplaceRolesAsync"
                          @onsubmit:preventDefault>
                        <h3>@LocalizedUiText.Get("Replace staff roles")</h3>
                        <AccessibleValidationSummary SummaryId="user-role-errors"
                                                     Heading="@(LocalizedUiText.Get("Review the role change"))"
                                                     Errors="@_roleErrors" />
                        <fieldset disabled="@IsBusy">
                            <legend>@LocalizedUiText.Get("Authorized roles")</legend>
                            @foreach (var role in AssignableRoles)
                            {
                                <label>
                                    <input type="checkbox"
                                           checked="@_selectedRoles.Contains(role)"
                                           @onchange="args => ToggleRole(role, args)" />
                                    @DisplayRole(role)
                                </label>
                            }
                        </fieldset>
                        <label for="role-change-reason">@LocalizedUiText.Get("Reason for role change")</label>
                        <textarea id="role-change-reason"
                                  maxlength="1000"
                                  disabled="@IsBusy"
                                  @bind="_roleReason"
                                  @bind:event="oninput"></textarea>
                        <button type="submit" disabled="@IsBusy">@LocalizedUiText.Get("Replace roles")</button>
                    </form>
                }

                <button type="button" disabled="@IsBusy" @onclick="RefreshSelectedUserAsync">
                    @LocalizedUiText.Get("Refresh selected user")
                </button>
            </section>
        }

        <section class="srs-admin-users__section" aria-labelledby="identity-import-heading">
            <h2 id="identity-import-heading">@LocalizedUiText.Get("Preview identity import")</h2>
            <p>@LocalizedUiText.Get("Add only pre-provisioning data. Generated credentials are never accepted here.")</p>

            <AccessibleValidationSummary SummaryId="identity-import-errors"
                                         Heading="@(LocalizedUiText.Get("Review the import"))"
                                         Errors="@_importValidationErrors" />

            <div class="srs-admin-users__editor">
                <label for="identity-import-source">@LocalizedUiText.Get("Source name")</label>
                <input id="identity-import-source"
                       maxlength="255"
                       disabled="@IsBusy"
                       @bind="_importSource"
                       @bind:event="oninput" />

                <label for="identity-import-rows">@LocalizedUiText.Get("Synthetic user rows (JSON array)")</label>
                <textarea id="identity-import-rows"
                          class="srs-admin-users__import-json"
                          spellcheck="false"
                          disabled="@IsBusy"
                          @bind="_importRowsJson"
                          @bind:event="oninput"></textarea>

                <button type="button" disabled="@IsBusy" @onclick="PreviewImport">
                    @LocalizedUiText.Get("Preview rows")
                </button>
            </div>

            @if (_importPreview.Count > 0)
            {
                <div class="srs-admin-users__import-preview" aria-live="polite">
                    <p><strong>@_importPreview.Count</strong> @LocalizedUiText.Get("rows ready for server validation.")</p>
                    <p class="srs-admin-users__hash">@LocalizedUiText.Get("Content hash:") @_importContentHash</p>
                    <ul>
                        @foreach (var row in _importPreview)
                        {
                            <li>@row.ExternalReference — @row.DisplayName — @row.Kind</li>
                        }
                    </ul>
                    <button type="button" disabled="@IsBusy" @onclick="CreateImportAsync">
                        @LocalizedUiText.Get("Submit import for validation")
                    </button>
                </div>
            }

            @if (_importBatch is not null)
            {
                <section class="srs-admin-users__import-result" aria-labelledby="import-result-heading">
                    <h3 id="import-result-heading">@LocalizedUiText.Get("Import status:") @_importBatch.State</h3>
                    <p>@LocalizedUiText.Get("Source:") @_importBatch.Source</p>
                    @if (_importBatch.Errors.Count > 0)
                    {
                        <table>
                            <caption>@LocalizedUiText.Get("Import row errors")</caption>
                            <thead><tr><th scope="col">@LocalizedUiText.Get("Row")</th><th scope="col">@LocalizedUiText.Get("Code")</th><th scope="col">@LocalizedUiText.Get("Message")</th></tr></thead>
                            <tbody>
                                @foreach (var error in _importBatch.Errors)
                                {
                                    <tr><td>@(error.Row?.ToString() ?? "General")</td><td>@error.Code</td><td>@error.Message</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="srs-admin-users__actions">
                        <button type="button" disabled="@IsBusy" @onclick="RefreshImportAsync">
                            @LocalizedUiText.Get("Refresh import status")
                        </button>
                        @if (CanPublishImport)
                        {
                            <button type="button" disabled="@IsBusy" @onclick="PublishImportAsync">
                                @LocalizedUiText.Get("Publish all rows")
                            </button>
                        }
                    </div>
                </section>
            }
        </section>
    </main>
</div>

<ConfirmationDialog IsOpen="@_showStatusConfirmation"
                    DialogId="status-change-dialog"
                    TitleId="status-change-dialog-title"
                    DescriptionId="status-change-dialog-description"
                    Title="@StatusConfirmationTitle"
                    Message="@StatusConfirmationMessage"
                    ConfirmLabel="@(LocalizedUiText.Get("Confirm status change"))"
                    CancelLabel="@(LocalizedUiText.Get("Cancel"))"
                    IsBusy="@_isChangingStatus"
                    BusyLabel="@(LocalizedUiText.Get("Changing account status…"))"
                    OnConfirm="ChangeStatusAsync"
                    OnCancel="CloseStatusConfirmation"
                    FocusRestoreRequested="RestoreStatusFocusAsync" />
