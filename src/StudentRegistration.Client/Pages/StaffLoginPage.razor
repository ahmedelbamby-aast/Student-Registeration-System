@page "/staff/login"
@inject IdentityApiClient IdentityApi
@inject NavigationManager Navigation

<PageTitle>@LocalizedUiText.Get("Staff login")</PageTitle>

<IdentityPageShell HeadingId="staff-login-heading"
                   Heading="@(LocalizedUiText.Get("Staff login"))"
                   Introduction="@(LocalizedUiText.Get("Admin, Lecturer, and Teaching Assistant use this one password-only login. Roles come from the server after sign-in."))">
    <IdentityFeedback IsBusy="IsSubmitting"
                      BusyMessage="@(LocalizedUiText.Get("Signing in once."))"
                      IsError="@(!string.IsNullOrWhiteSpace(_feedbackCode))"
                      Heading="@_feedbackHeading"
                      Message="@_feedbackMessage"
                      State="@_feedbackState"
                      Code="@_feedbackCode"
                      CorrelationId="@_correlationId" />

    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault data-testid="staff-login-form">
        <AccessibleValidationSummary SummaryId="staff-login-errors"
                                     Heading="@(LocalizedUiText.Get("Review the sign-in details"))"
                                     Errors="@_validationErrors" />

        <FormField InputId="staff-user-name"
                   Name="userName"
                   Label="@(LocalizedUiText.Get("Staff username"))"
                   Type="text"
                   autocomplete="username"
                   Required="true"
                   Disabled="IsSubmitting"
                   ErrorMessage="@ErrorFor("staff-user-name")"
                   @bind-Value="_userName" />

        <FormField InputId="staff-password"
                   Name="password"
                   Label="@(LocalizedUiText.Get("Password"))"
                   Type="password"
                   autocomplete="current-password"
                   AllowSecretReveal="true"
                   Required="true"
                   Disabled="IsSubmitting"
                   ErrorMessage="@ErrorFor("staff-password")"
                   @bind-Value="_password" />

        <AppButton Type="submit"
                   IsLoading="@IsSubmitting"
                   Disabled="@IsSubmitting"
                   LoadingAnnouncement="@(LocalizedUiText.Get("Signing in once."))">
            @(IsSubmitting ? LocalizedUiText.Get("Signing in…") : LocalizedUiText.Get("Sign in"))
        </AppButton>
    </form>
</IdentityPageShell>

@code {
    private static readonly HashSet<string> StaffRoles =
        new(StringComparer.Ordinal) { "Admin", "Lecturer", "TeachingAssistant" };

    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string? _feedbackCode;
    private string? _feedbackMessage;
    private string _feedbackHeading = LocalizedUiText.Get("Sign-in status");
    private string? _feedbackState;
    private string? _correlationId;
    private IReadOnlyList<AccessibleValidationSummary.ValidationItem> _validationErrors = [];

    private bool IsSubmitting { get; set; }

    private async Task SubmitAsync()
    {
        if (IsSubmitting || !Validate())
        {
            return;
        }

        ResetOutcome();
        IsSubmitting = true;
        try
        {
            var result = await IdentityApi.LoginStaffAsync(
                new StaffLoginRequest(_userName, _password));
            _password = string.Empty;
            if (result.IsSuccess && result.Value is not null)
            {
                await HandleSessionAsync(result.Value);
                return;
            }

            ApplyFailure(result.Error);
        }
        catch (HttpRequestException)
        {
            _password = string.Empty;
            ApplyFailure(null);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private Task HandleSessionAsync(SessionDto session)
    {
        if (!string.IsNullOrWhiteSpace(session.ActiveRole) &&
            session.Roles.Count == 1 &&
            session.Roles.Contains(session.ActiveRole, StringComparer.Ordinal) &&
            StaffRoles.Contains(session.ActiveRole))
        {
            NavigateForRole(session.ActiveRole);
            return Task.CompletedTask;
        }

        ApplyUnsupportedRoleConfiguration();
        return Task.CompletedTask;
    }

    private void NavigateForRole(string role)
    {
        if (string.Equals(role, "Admin", StringComparison.Ordinal))
        {
            Navigation.NavigateTo("/admin");
            return;
        }

        Navigation.NavigateTo("/staff");
    }

    private bool Validate()
    {
        var errors = new List<AccessibleValidationSummary.ValidationItem>();
        if (string.IsNullOrWhiteSpace(_userName))
        {
            errors.Add(new("staff-user-name", LocalizedUiText.Get("Enter your Staff username.")));
        }

        if (string.IsNullOrEmpty(_password))
        {
            errors.Add(new("staff-password", LocalizedUiText.Get("Enter your password.")));
        }

        _validationErrors = errors;
        return errors.Count == 0;
    }

    private string? ErrorFor(string controlId) =>
        _validationErrors.FirstOrDefault(error => error.ControlId == controlId)?.Message;

    private void ApplyFailure(ApiError? error)
    {
        _feedbackCode = error?.Code ?? "SERVICE_UNAVAILABLE";
        _feedbackHeading = _feedbackCode == "RATE_LIMITED"
            ? LocalizedUiText.Get("Try again later")
            : _feedbackCode == "SERVICE_UNAVAILABLE"
                ? LocalizedUiText.Get("Staff sign-in unavailable")
                : LocalizedUiText.Get("Sign-in not accepted");
        _feedbackMessage = IdentityPageFeedback.SafeMessageFor(_feedbackCode);
        _feedbackState = IdentityPageFeedback.MapFailure(
            IdentityRouteStateMapper.StaffLoginRecord,
            _feedbackCode).ServiceState;
        _correlationId = error?.CorrelationId;
    }

    private void ResetOutcome()
    {
        _feedbackCode = null;
        _feedbackMessage = null;
        _feedbackState = null;
        _correlationId = null;
    }

    private void ApplyUnsupportedRoleConfiguration()
    {
        _feedbackCode = "INVALID_ROLE_CONFIGURATION";
        _feedbackHeading = LocalizedUiText.Get("Staff account configuration unavailable");
        _feedbackMessage = LocalizedUiText.Get("Each staff account must have exactly one role: Admin, Lecturer, or Teaching Assistant. Contact an administrator to correct this account.");
        _feedbackState = "error";
        _correlationId = null;
    }
}
