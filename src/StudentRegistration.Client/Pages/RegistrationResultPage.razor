@page "/student/registration/result/{Id:guid}"
@using System.Globalization
@using System.Net
@using StudentRegistration.Client.Components.Layout
@using StudentRegistration.Client.Components.Navigation
@using StudentRegistration.Client.Components.Registration
@using StudentRegistration.Client.Components.Scheduling
@using StudentRegistration.Client.Features.Academics
@using StudentRegistration.Client.Features.Registration
@using StudentRegistration.Contracts
@using StudentRegistration.Contracts.Registration
@inject AcademicApiClient AcademicApi
@inject RegistrationApiClient RegistrationApi
@inject IJSRuntime JavaScript

<PageTitle>@LocalizedUiText.Get("Registration result | Student Registration")</PageTitle>

@if (_loading)
{
    <div data-route-id="STU-06" data-state="loading" data-contract-state="STU-06-COMP-STATE-LOADING">
        <a href="#main-content">@LocalizedUiText.Get("Skip to main content")</a>
        <main id="main-content" tabindex="-1">
            <h1>@LocalizedUiText.Get("Registration result")</h1>
            <p role="status" aria-live="polite" aria-busy="true">@LocalizedUiText.Get("Loading the authoritative registration result.")</p>
        </main>
    </div>
}
else if (_shellContext is not null)
{
    <AppShell Context="@_shellContext"
              MainContentId="main-content"
              SkipLinkLabel="@(LocalizedUiText.Get("Skip to main content"))"
              BrandLogoSource="/brand/aastmt-logo.png"
              BrandLogoAccessibleName="@(LocalizedUiText.Get("Arab Academy for Science, Technology and Maritime Transport"))"
              ServerDateTimeLabel="@(LocalizedUiText.Get("Server date and time"))"
              TeachingTermLabel="@(LocalizedUiText.Get("Teaching term"))"
              RegistrationTermLabel="@(LocalizedUiText.Get("Registration term"))"
              RegistrationWindowLabel="@(LocalizedUiText.Get("Registration window"))"
              NoTeachingTermLabel="@(LocalizedUiText.Get("No current teaching term"))"
              NoRegistrationTermLabel="@(LocalizedUiText.Get("No current registration term"))"
              NoRegistrationWindowLabel="@(LocalizedUiText.Get("No registration window"))"
              AuthorizedRolesLabel="@(LocalizedUiText.Get("Authorized roles"))"
              ActiveRoleLabel="@(LocalizedUiText.Get("Active role"))"
              SessionLabel="@(LocalizedUiText.Get("Session"))"
              ServiceLabel="@(LocalizedUiText.Get("Service"))"
              SupportLinkLabel="@(LocalizedUiText.Get("Open support"))"
              LoadingLabel="@(LocalizedUiText.Get("Loading registration result"))">
        <Navigation><RoleNavigation AccessibleName="@(LocalizedUiText.Get("Student role navigation"))" Items="@StudentNavigation" /></Navigation>
        <ChildContent>@ResultContent</ChildContent>
    </AppShell>
}
else
{
    <a href="#main-content">@LocalizedUiText.Get("Skip to main content")</a>
    <main id="main-content" tabindex="-1">@ResultContent</main>
}

@code {
    private static readonly IReadOnlyList<RoleNavigation.NavigationItem> StudentNavigation =
    [
        new(LocalizedUiText.Get("Dashboard"), "/student"),
        new(LocalizedUiText.Get("Current plan"), "/student/schedule"),
        new(LocalizedUiText.Get("Registrations"), "/student/registrations", IsActive: true)
    ];

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public Guid? TermId { get; set; }
    [SupplyParameterFromQuery] public Guid? ClientRequestId { get; set; }

    private FrontendAppContextView? _shellContext;
    private RegistrationDetailDto? _detail;
    private IReadOnlyList<ScheduleCalendar.ScheduleMeetingItem> _meetings = [];
    private string _state = "loading";
    private string _reasonCode = "REGISTRATION_RESULT_UNAVAILABLE";
    private string _message = LocalizedUiText.Get("The registration result could not be loaded safely.");
    private string? _reference;
    private bool _loading = true;
    private bool _retrying;

    private string ContractState => _state switch
    {
        "success" => "STU-06-COMP-STATE-SUCCESS",
        "validation-error" => "STU-06-COMP-STATE-VALIDATION-ERROR",
        "unauthorized" => "STU-06-COMP-STATE-UNAUTHORIZED",
        "stale" => "STU-06-COMP-STATE-STALE",
        _ => "STU-06-COMP-STATE-SERVICE-ERROR"
    };

    private RenderFragment ResultContent => @<article class="srs-registration-result"
        data-route-id="STU-06" data-state="@_state" data-contract-state="@ContractState">
        <header class="srs-registration-result__intro">
            <div><p>@LocalizedUiText.Get("Student registration")</p><h1>@LocalizedUiText.Get("Atomic registration result")</h1></div>
            <a href="/student/registrations">@LocalizedUiText.Get("Registration history")</a>
        </header>

        @if (_detail?.Receipt is { } receipt)
        {
            <section class="srs-registration-result__outcome srs-registration-result__outcome--accepted" role="status" aria-live="polite">
                <h2>@LocalizedUiText.Get("Registration accepted")</h2>
                <p>@LocalizedUiText.Get("The complete registration was accepted as one transaction.")</p>
            </section>
            <ReceiptSummary ComponentId="registration-receipt"
                            Heading="@(LocalizedUiText.Get("Registration receipt"))"
                            ReferenceLabel="@(LocalizedUiText.Get("Receipt reference"))"
                            Reference="@receipt.Reference"
                            PrintLabel="@(LocalizedUiText.Get("Print receipt"))"
                            Items="@ReceiptItems(receipt)"
                            OnPrint="PrintAsync" />
            <section aria-labelledby="registered-groups-heading">
                <h2 id="registered-groups-heading">@LocalizedUiText.Get("Registered groups")</h2>
                <ul class="srs-registration-result__groups">
                    @foreach (var group in receipt.Groups)
                    {
                        <li data-group-id="@group.GroupId">
                            <h3>@group.CourseCode @group.SubjectTitle</h3>
                            <p>@LocalizedUiText.Get("Group") @group.GroupCode · @group.Credits.ToString("0.##", CultureInfo.CurrentCulture) @LocalizedUiText.Get("credits")</p>
                        </li>
                    }
                </ul>
            </section>
            <div class="srs-registration-result__schedule">
                <ScheduleCalendar Heading="@(LocalizedUiText.Get("Registered timetable"))"
                                  EquivalentListId="registration-result-list"
                                  DayColumnLabel="@(LocalizedUiText.Get("Day"))" TimeColumnLabel="@(LocalizedUiText.Get("Time"))" MeetingColumnLabel="@(LocalizedUiText.Get("Meeting"))"
                                  GroupLabel="@(LocalizedUiText.Get("Group"))" ActivityKindLabel="@(LocalizedUiText.Get("Activity"))" LecturerLabel="@(LocalizedUiText.Get("Lecturer"))"
                                  TeachingAssistantsLabel="@(LocalizedUiText.Get("Teaching assistants"))" LocationLabel="@(LocalizedUiText.Get("Location"))" ConflictLabel="@(LocalizedUiText.Get("Conflict"))"
                                  Meetings="@_meetings" />
                <ScheduleList ComponentId="registration-result-list"
                              EquivalentCalendarId="registration-result-list-calendar-heading"
                              Heading="@(LocalizedUiText.Get("Registered timetable list"))"
                              GroupLabel="@(LocalizedUiText.Get("Group"))" ActivityKindLabel="@(LocalizedUiText.Get("Activity"))" LecturerLabel="@(LocalizedUiText.Get("Lecturer"))"
                              TeachingAssistantsLabel="@(LocalizedUiText.Get("Teaching assistants"))" LocationLabel="@(LocalizedUiText.Get("Location"))"
                              DayLabel="@(LocalizedUiText.Get("Day"))" StartLabel="@(LocalizedUiText.Get("Starts"))" EndLabel="@(LocalizedUiText.Get("Ends"))" TimezoneLabel="@(LocalizedUiText.Get("Time zone"))" ConflictLabel="@(LocalizedUiText.Get("Conflict"))"
                              Meetings="@_meetings" />
            </div>
        }
        else if (_detail?.Rejection is { } rejection)
        {
            <section class="srs-registration-result__outcome srs-registration-result__outcome--rejected" role="alert" aria-live="assertive">
                <h2>@LocalizedUiText.Get("Registration rejected")</h2>
                <p><strong>@rejection.ResultCode</strong></p>
                <p>@rejection.SafeMessage</p>
                @if (rejection.NoPartialRegistration)
                {
                    <p><strong>@LocalizedUiText.Get("No subjects were partially registered.")</strong></p>
                }
                <p>@LocalizedUiText.Get("Completed at") @FormatDate(rejection.CompletedAtUtc).</p>
                <a href="/student/schedule">@LocalizedUiText.Get("Edit plan")</a>
            </section>
        }
        else
        {
            <section class="srs-registration-result__outcome" role="@(_state == "unauthorized" ? "alert" : "status")" aria-live="polite">
                <h2>@FailureHeading</h2>
                <p><strong>@_reasonCode</strong></p>
                <p>@_message</p>
                @if (!string.IsNullOrWhiteSpace(_reference)) { <p>@LocalizedUiText.Get("Reference:") @_reference</p> }
                @if (_state is "service-error" or "stale")
                {
                    <button type="button" disabled="@_retrying" @onclick="RetryAsync">@LocalizedUiText.Get("Retry result lookup")</button>
                }
                <a href="@(_shellContext?.SupportReferencePath ?? "/student")">@LocalizedUiText.Get("Open safe support path")</a>
            </section>
        }
    </article>;

    private string FailureHeading => _state switch
    {
        "unauthorized" => LocalizedUiText.Get("Access denied"),
        "stale" => LocalizedUiText.Get("Registration result needs recovery"),
        _ => LocalizedUiText.Get("Registration result is unavailable")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await AcademicApi.GetAppContextAsync();
            if (!context.IsSuccess || context.Value is null)
            {
                ApplyFailure(context.StatusCode, context.Error);
                return;
            }
            if (!RegistrationPageSupport.IsStudentContext(context.Value))
            {
            ApplyFailure(HttpStatusCode.Forbidden, new("FORBIDDEN", LocalizedUiText.Get("A Student session is required."), "STU-06-AUTH"));
                return;
            }
            _shellContext = RegistrationPageSupport.ToShellContext(context.Value);
            await LoadDetailAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JSException)
        {
            ApplyOffline();
        }
        finally { _loading = false; }
    }

    private async Task LoadDetailAsync()
    {
        var result = await RegistrationApi.GetRegistrationDetailAsync(Id);
        if (!result.IsSuccess || result.Value is null)
        {
            ApplyFailure(result.StatusCode, result.Error);
            return;
        }

        _detail = result.Value;
        if (_detail.Receipt is { } receipt)
        {
            _state = "success";
            _meetings = RegistrationPageSupport.ToMeetingItems(receipt.Groups, receipt.Term.TimeZoneId);
        }
        else if (_detail.Rejection is not null)
        {
            _state = "validation-error";
            _meetings = [];
        }
        else
        {
            ApplyFailure(HttpStatusCode.ServiceUnavailable, new("INVALID_RESULT", LocalizedUiText.Get("The server returned no authoritative outcome."), "STU-06-RESULT"));
        }
    }

    private async Task RetryAsync()
    {
        if (_retrying) return;
        _retrying = true;
        try
        {
            if (TermId is { } termId && ClientRequestId is { } requestId)
            {
                var lookup = await RegistrationApi.LookupRegistrationAsync(termId, requestId);
                if (!lookup.IsSuccess)
                {
                    ApplyFailure(lookup.StatusCode, lookup.Error);
                    return;
                }
            }
            await LoadDetailAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JSException) { ApplyOffline(); }
        finally { _retrying = false; }
    }

    private void ApplyFailure(HttpStatusCode status, ApiError? error)
    {
        _detail = null;
        _meetings = [];
        _reasonCode = error?.Code ?? "REGISTRATION_RESULT_UNAVAILABLE";
        _message = error?.Message ?? LocalizedUiText.Get("The registration result could not be loaded safely.");
        _reference = error?.CorrelationId;
        _state = status is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden or HttpStatusCode.NotFound
            ? "unauthorized"
            : TermId.HasValue && ClientRequestId.HasValue ? "stale" : "service-error";
    }

    private void ApplyOffline()
    {
        _detail = null; _meetings = []; _state = "service-error"; _reasonCode = "OFFLINE";
        _message = LocalizedUiText.Get("Reconnect, then retry. No registration change was made."); _reference = null;
    }

    private static IReadOnlyList<ReceiptSummary.ReceiptItem> ReceiptItems(RegistrationReceiptDto receipt) =>
    [
            new(LocalizedUiText.Get("Term"), receipt.Term.DisplayName),
        new(LocalizedUiText.Get("Submitted"), FormatDate(receipt.SubmittedAtUtc)),
        new(LocalizedUiText.Get("Result"), receipt.ResultCode),
        new(LocalizedUiText.Get("Total credits"), LocalizedUiText.Format("{0} credits", receipt.TotalCredits.ToString("0.##", CultureInfo.CurrentCulture))),
        new(LocalizedUiText.Get("Policy version"), receipt.PolicyVersion)
    ];

    private static string FormatDate(DateTime value) => value.ToUniversalTime().ToString("g", CultureInfo.CurrentCulture);
    private Task PrintAsync() => JavaScript.InvokeVoidAsync("window.print").AsTask();
}
