@page "/student/registrations"
@using System.Globalization
@using System.Net
@using StudentRegistration.Client.Components.Data
@using StudentRegistration.Client.Components.Layout
@using StudentRegistration.Client.Components.Navigation
@using StudentRegistration.Client.Components.Scheduling
@using StudentRegistration.Client.Features.Academics
@using StudentRegistration.Client.Features.Registration
@using StudentRegistration.Contracts
@using StudentRegistration.Contracts.Registration
@inject AcademicApiClient AcademicApi
@inject RegistrationApiClient RegistrationApi
@inject IJSRuntime JavaScript

<PageTitle>@LocalizedUiText.Get("Registration history | Student Registration")</PageTitle>

@if (_loading)
{
    <div data-route-id="STU-07" data-state="loading" data-contract-state="STU-07-COMP-STATE-LOADING">
        <main id="main-content" tabindex="-1"><h1>@LocalizedUiText.Get("Registration history")</h1><p role="status" aria-busy="true">@LocalizedUiText.Get("Loading registration records.")</p></main>
    </div>
}
else if (_shellContext is not null)
{
    <AuthenticatedPage Context="@_shellContext"
                       Workspace="WorkspaceKind.Student"
                       CurrentRouteId="STU-07"
                       Density="UiDensity.Comfortable"
                       Heading="@(LocalizedUiText.Get("Registrations"))"
                       Eyebrow="@(LocalizedUiText.Get("Student registration"))"
                       Description="@(LocalizedUiText.Get("Server-authored current and archived records."))"
                       LoadingLabel="@(LocalizedUiText.Get("Loading registration history"))">
        @HistoryContent
    </AuthenticatedPage>
}
else
{
    <main id="main-content" tabindex="-1">@HistoryContent</main>
}

@code {
    private const int PageSize = 20;
    private FrontendAppContextView? _shellContext;
    private Page<RegistrationHistoryRowDto>? _history;
    private RegistrationTimetableDto? _timetable;
    private IReadOnlyList<ScheduleCalendar.ScheduleMeetingItem> _meetings = [];
    private string _state = "loading";
    private string _reasonCode = "REGISTRATION_HISTORY_UNAVAILABLE";
    private string _message = LocalizedUiText.Get("Registration records could not be loaded safely.");
    private string? _reference;
    private bool _loading = true;
    private bool _requesting;

    private string ContractState => _state switch
    {
        "success" => "STU-07-COMP-STATE-SUCCESS",
        "empty" => "STU-07-COMP-STATE-EMPTY",
        "unauthorized" => "STU-07-COMP-STATE-UNAUTHORIZED",
        _ => "STU-07-COMP-STATE-SERVICE-ERROR"
    };

    private RenderFragment HistoryContent => @<article class="srs-registration-history"
        data-route-id="STU-07" data-state="@_state" data-contract-state="@ContractState">
        <header class="srs-registration-history__intro">
            <div><p>@LocalizedUiText.Get("Student registration")</p><h1>@LocalizedUiText.Get("Registrations")</h1><p>@LocalizedUiText.Get("Server-authored current and archived records.")</p></div>
            <AppButton Variant="AppButtonVariant.Secondary" OnClick="PrintAsync">@LocalizedUiText.Get("Print history")</AppButton>
        </header>

        @if (_state is "service-error" or "unauthorized")
        {
            <section class="srs-registration-history__state" role="@(_state == "unauthorized" ? "alert" : "status")" aria-live="polite">
                <h2>@(_state == "unauthorized" ? LocalizedUiText.Get("Access denied") : LocalizedUiText.Get("Registration history is unavailable"))</h2>
                <p><strong>@_reasonCode</strong></p><p>@_message</p>
                @if (!string.IsNullOrWhiteSpace(_reference)) { <p>@LocalizedUiText.Get("Reference:") <span>@_reference</span></p> }
                @if (_state == "service-error") { <AppButton Disabled="@_requesting" IsLoading="@_requesting" OnClick="@(_ => LoadRecordsAsync(1))">@LocalizedUiText.Get("Retry registration records")</AppButton> }
                <a href="@(_shellContext?.SupportReferencePath ?? "/student")">@LocalizedUiText.Get("Open safe support path")</a>
            </section>
        }
        else if (_state == "empty")
        {
            <section class="srs-registration-history__state" role="status" aria-live="polite">
                <h2>@LocalizedUiText.Get("No registrations for") @(_timetable?.Term?.DisplayName ?? "this term")</h2><p>@LocalizedUiText.Get("No accepted or rejected registration has been recorded.")</p>
                @if (CanFindSubjects) { <a href="@_timetable!.SubjectDiscoveryPath">@LocalizedUiText.Get("Find subjects")</a> }
            </section>
        }
        else if (_history is not null && _timetable is not null)
        {
            <nav class="srs-registration-history__selector" aria-label="@(LocalizedUiText.Get("Registration view"))">
                <a href="#current-registration">@LocalizedUiText.Get("Current timetable")</a>
                <a href="#registration-records">@LocalizedUiText.Get("History records")</a>
            </nav>
            <section id="current-registration" aria-labelledby="current-timetable-heading">
                <h2 id="current-timetable-heading">@LocalizedUiText.Get("Current registration timetable")</h2>
                @if (_meetings.Count == 0) { <p>@LocalizedUiText.Get("No current registered meetings.")</p> }
                else
                {
                    <div class="srs-registration-history__schedule">
                        <ScheduleCalendar Heading="@(LocalizedUiText.Get("Current registered timetable calendar"))" EquivalentListId="registration-history-list"
                                          DayColumnLabel="@(LocalizedUiText.Get("Day"))" TimeColumnLabel="@(LocalizedUiText.Get("Time"))" MeetingColumnLabel="@(LocalizedUiText.Get("Meeting"))"
                                          GroupLabel="@(LocalizedUiText.Get("Group"))" ActivityKindLabel="@(LocalizedUiText.Get("Activity"))" LecturerLabel="@(LocalizedUiText.Get("Lecturer"))"
                                          TeachingAssistantsLabel="@(LocalizedUiText.Get("Teaching assistants"))" LocationLabel="@(LocalizedUiText.Get("Location"))" ConflictLabel="@(LocalizedUiText.Get("Conflict"))" Meetings="@_meetings" />
                        <ScheduleList ComponentId="registration-history-list" EquivalentCalendarId="registration-history-list-calendar-heading"
                                      Heading="@(LocalizedUiText.Get("Current registered timetable list"))" GroupLabel="@(LocalizedUiText.Get("Group"))" ActivityKindLabel="@(LocalizedUiText.Get("Activity"))"
                                      LecturerLabel="@(LocalizedUiText.Get("Lecturer"))" TeachingAssistantsLabel="@(LocalizedUiText.Get("Teaching assistants"))" LocationLabel="@(LocalizedUiText.Get("Location"))"
                                      DayLabel="@(LocalizedUiText.Get("Day"))" StartLabel="@(LocalizedUiText.Get("Starts"))" EndLabel="@(LocalizedUiText.Get("Ends"))" TimezoneLabel="@(LocalizedUiText.Get("Time zone"))" ConflictLabel="@(LocalizedUiText.Get("Conflict"))" Meetings="@_meetings" />
                    </div>
                }
            </section>

            <section id="registration-records" aria-labelledby="records-heading">
                <h2 id="records-heading">@LocalizedUiText.Get("Registration records")</h2>
                <p role="status">@_history.TotalCount @LocalizedUiText.Get("registration records")</p>
                <div class="srs-registration-history__table" role="region" aria-label="@(LocalizedUiText.Get("Registration records table"))" tabindex="0">
                    <table><caption>@LocalizedUiText.Get("Current and archived registration outcomes")</caption><thead><tr>
                        <th scope="col">@LocalizedUiText.Get("Reference")</th><th scope="col">@LocalizedUiText.Get("Term")</th><th scope="col">@LocalizedUiText.Get("Submitted")</th>
                        <th scope="col">@LocalizedUiText.Get("Status")</th><th scope="col">@LocalizedUiText.Get("Groups")</th><th scope="col">@LocalizedUiText.Get("Credits")</th><th scope="col">@LocalizedUiText.Get("Details")</th>
                    </tr></thead><tbody>
                    @foreach (var record in _history.Items)
                    {
                        <tr data-submission-id="@record.SubmissionId">
                            <td>@(record.Reference ?? LocalizedUiText.Get("Not issued"))</td><td>@record.Term.DisplayName @ArchivedLabel(record)</td><td>@FormatDate(record.SubmittedAtUtc)</td>
                            <td>@record.Status</td><td>@record.GroupCount</td><td>@record.TotalCredits.ToString("0.##", CultureInfo.CurrentCulture)</td>
                            <td><a href="/student/registration/result/@record.SubmissionId.ToString("D")">@LocalizedUiText.Get("View result")</a></td>
                        </tr>
                    }
                    </tbody></table>
                </div>
                <ol class="srs-registration-history__cards" aria-label="@(LocalizedUiText.Get("Registration records compact view"))">
                    @foreach (var record in _history.Items)
                    {
                        <li data-submission-id="@record.SubmissionId">
                            <h3>@LocalizedUiText.Get("Registration record")</h3>
                            <dl>
                                <div><dt>@LocalizedUiText.Get("Reference")</dt><dd>@(record.Reference ?? LocalizedUiText.Get("Not issued"))</dd></div>
                                <div><dt>@LocalizedUiText.Get("Term")</dt><dd>@record.Term.DisplayName @ArchivedLabel(record)</dd></div>
                                <div><dt>@LocalizedUiText.Get("Submitted")</dt><dd>@FormatDate(record.SubmittedAtUtc)</dd></div>
                                <div><dt>@LocalizedUiText.Get("Status")</dt><dd>@record.Status</dd></div>
                                <div><dt>@LocalizedUiText.Get("Groups")</dt><dd>@record.GroupCount</dd></div>
                                <div><dt>@LocalizedUiText.Get("Credits")</dt><dd>@record.TotalCredits.ToString("0.##", CultureInfo.CurrentCulture)</dd></div>
                            </dl>
                            <a href="/student/registration/result/@record.SubmissionId.ToString("D")">@LocalizedUiText.Get("View result")</a>
                        </li>
                    }
                </ol>
                @if (TotalPages > 1)
                {
                    <Pagination AccessibleLabel="@(LocalizedUiText.Get("Registration history pages"))" PreviousLabel="@(LocalizedUiText.Get("Previous"))" NextLabel="@(LocalizedUiText.Get("Next"))"
                                CurrentPage="@_history.PageNumber" TotalPages="@TotalPages" VisiblePages="@VisiblePages"
                                PageLabel="@(page => page.ToString(CultureInfo.CurrentCulture))"
                                CurrentPageLabel="@((page, total) => LocalizedUiText.Format("Page {0} of {1}", page, total))"
                                PageChanged="LoadRecordsAsync" IsLoading="@_requesting" LoadingLabel="@(LocalizedUiText.Get("Loading registration records"))" />
                }
            </section>
        }
    </article>;

    private bool CanFindSubjects => _timetable is not null
        && string.Equals(_timetable.RegistrationWindowState, "open", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(_timetable.SubjectDiscoveryPath);
    private int TotalPages => _history is null ? 1 : Math.Max(1, (int)Math.Ceiling(_history.TotalCount / (double)_history.PageSize));
    private IReadOnlyList<int> VisiblePages => _history is null ? [1] : Enumerable.Range(1, TotalPages).Where(page => Math.Abs(page - _history.PageNumber) <= 2).ToArray();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await AcademicApi.GetAppContextAsync();
            if (!context.IsSuccess || context.Value is null) { ApplyFailure(context.StatusCode, context.Error); return; }
            if (!RegistrationPageSupport.IsStudentContext(context.Value))
            { ApplyFailure(HttpStatusCode.Forbidden, new("FORBIDDEN", LocalizedUiText.Get("A Student session is required."), "STU-07-AUTH")); return; }
            _shellContext = RegistrationPageSupport.ToShellContext(context.Value);
            await LoadRecordsAsync(1);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JSException) { ApplyOffline(); }
        finally { _loading = false; }
    }

    private async Task LoadRecordsAsync(int page)
    {
        if (_requesting) return;
        _requesting = true;
        try
        {
            var historyTask = RegistrationApi.GetRegistrationHistoryAsync(page, PageSize);
            var timetableTask = RegistrationApi.GetCurrentRegistrationTimetableAsync();
            await Task.WhenAll(historyTask, timetableTask);
            var history = await historyTask; var timetable = await timetableTask;
            if (!history.IsSuccess || history.Value is null) { ApplyFailure(history.StatusCode, history.Error); return; }
            if (!timetable.IsSuccess || timetable.Value is null) { ApplyFailure(timetable.StatusCode, timetable.Error); return; }
            _history = history.Value; _timetable = timetable.Value;
            _meetings = _timetable.Term is null ? [] : RegistrationPageSupport.ToMeetingItems(_timetable.Groups, _timetable.Term.TimeZoneId);
            _state = _history.TotalCount == 0 && _meetings.Count == 0 ? "empty" : "success";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JSException) { ApplyOffline(); }
        finally { _requesting = false; }
    }

    private void ApplyFailure(HttpStatusCode status, ApiError? error)
    {
        _history = null; _timetable = null; _meetings = [];
        _reasonCode = error?.Code ?? "REGISTRATION_HISTORY_UNAVAILABLE";
        _message = error?.Message ?? LocalizedUiText.Get("Registration records could not be loaded safely.");
        _reference = error?.CorrelationId;
        _state = status is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden ? "unauthorized" : "service-error";
    }
    private void ApplyOffline() { _history = null; _timetable = null; _meetings = []; _state = "service-error"; _reasonCode = "OFFLINE"; _message = LocalizedUiText.Get("Reconnect, then retry registration records."); _reference = null; }
    private static string FormatDate(DateTime value) => value.ToUniversalTime().ToString("g", CultureInfo.CurrentCulture);
    private static string ArchivedLabel(RegistrationHistoryRowDto record) =>
        string.Equals(record.TermState, "archived", StringComparison.OrdinalIgnoreCase) ? "(Archived)" : string.Empty;
    private Task PrintAsync() => JavaScript.InvokeVoidAsync("window.print").AsTask();
}
