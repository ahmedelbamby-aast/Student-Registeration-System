@page "/admin/catalogue"
@using System.Globalization
@using System.Net
@using System.Text.Json
@using StudentRegistration.Client.Components.Navigation
@using StudentRegistration.Client.Components.Overlay
@using StudentRegistration.Client.Features.Academics
@using StudentRegistration.Contracts.Academics
@inject CatalogueApiClient CatalogueApi

<PageTitle>@LocalizedUiText.Get("Catalogue administration | Student Registration")</PageTitle>

<div class="srs-catalogue"
     data-route-id="ADM-05"
     data-state="@_state"
     data-contract-state="@CurrentStateFixture">
    <a class="srs-skip-link" href="#main-content">@LocalizedUiText.Get("Skip to main content")</a>

    <header class="srs-catalogue__header" role="banner">
        <a class="srs-catalogue__brand" href="/admin" aria-label="@(LocalizedUiText.Get("Administration home"))">
            <img src="/brand/aastmt-logo.png"
                 alt="@(LocalizedUiText.Get("Arab Academy for Science, Technology and Maritime Transport"))" />
            <span><strong>@LocalizedUiText.Get("AASTMT")</strong><small>@LocalizedUiText.Get("Student Registration")</small></span>
        </a>
        <RoleNavigation AccessibleName="@(LocalizedUiText.Get("Administration navigation"))"
                        Items="@AdministrationNavigation" />
    </header>

    <main id="main-content" tabindex="-1" data-testid="catalogue-administration-page">
        <section class="srs-catalogue__intro"
                 aria-labelledby="catalogue-administration-heading">
            <p class="srs-catalogue__eyebrow">@LocalizedUiText.Get("Governed academic master data")</p>
            <h1 id="catalogue-administration-heading" tabindex="-1">
                @LocalizedUiText.Get("Catalogue and policy administration")
            </h1>
            <p>
                @LocalizedUiText.Get("Review a curated programme subset, keep field provenance beside every value, validate prerequisite and typed-policy rules, simulate without saving, and publish only after server confirmation.")
            </p>
        </section>

        @if (_state is LoadingState)
        {
            <section class="srs-catalogue__panel"
                     role="status"
                     aria-live="polite"
                     aria-busy="true">
                <h2>@LocalizedUiText.Get("Loading catalogue and policy versions")</h2>
                <p>@LocalizedUiText.Get("The bounded owner APIs are being requested once.")</p>
            </section>
        }
        else if (_state is UnauthorizedState or SessionExpiredState)
        {
            <section class="srs-catalogue__panel srs-catalogue__panel--danger"
                     role="alert"
                     aria-live="assertive">
                <h2 @ref="_stateHeading" tabindex="-1">
                    @(_state is SessionExpiredState ? LocalizedUiText.Get("Session expired") : LocalizedUiText.Get("Catalogue access denied"))
                </h2>
                <p class="srs-catalogue__code">@_reasonCode</p>
                <p>@_safeMessage</p>
                <a href="@(_state is SessionExpiredState ? "/staff/login" : "/admin")">
                    @(_state is SessionExpiredState ? LocalizedUiText.Get("Sign in again") : LocalizedUiText.Get("Return to authorized home"))
                </a>
            </section>
        }
        else if (_state is ServiceErrorState or OfflineState)
        {
            <section class="srs-catalogue__panel srs-catalogue__panel--warning"
                     role="status"
                     aria-live="polite">
                <h2 @ref="_stateHeading" tabindex="-1">
                    @(_state is OfflineState
                        ? "Catalogue administration is offline"
                        : "Catalogue administration service unavailable")
                </h2>
                <p class="srs-catalogue__code">@_reasonCode</p>
                <p>@_safeMessage</p>
                @if (!string.IsNullOrWhiteSpace(_referenceId))
                {
                    <p>@LocalizedUiText.Get("Reference") <strong>@_referenceId</strong></p>
                }
                <div class="srs-catalogue__actions">
                    <button type="button" @onclick="LoadAsync">@LocalizedUiText.Get("Retry")</button>
                    <a href="/status/support">@LocalizedUiText.Get("Open safe support path")</a>
                </div>
            </section>
        }
        else
        {
            @if (_state is EmptyState)
            {
                <section class="srs-catalogue__panel" aria-labelledby="catalogue-empty-heading">
                    <h2 id="catalogue-empty-heading" @ref="_stateHeading" tabindex="-1">
                        @LocalizedUiText.Get("No catalogue versions are available")
                    </h2>
                    <p>@LocalizedUiText.Get("Retry after an authorized draft or version has been created.")</p>
                </section>
            }

            @if (_state is StaleState)
            {
                <section class="srs-catalogue__panel srs-catalogue__panel--warning"
                         role="status"
                         aria-live="polite">
                    <h2 @ref="_stateHeading" tabindex="-1">
                        @LocalizedUiText.Get("Publication confirmation is stale")
                    </h2>
                    <p class="srs-catalogue__code">@_reasonCode</p>
                    <p>@_safeMessage</p>
                    @if (!string.IsNullOrWhiteSpace(_currentVersion))
                    {
                        <p>@LocalizedUiText.Get("Current version") <code>@_currentVersion</code></p>
                    }
                    <button type="button" @onclick="RefreshAndRevalidateAsync">
                        @LocalizedUiText.Get("Refresh and revalidate")
                    </button>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_successAnnouncement))
            {
                <section class="srs-catalogue__panel srs-catalogue__panel--success"
                         role="status"
                         aria-live="polite">
                    <h2>@LocalizedUiText.Get("Server-confirmed result")</h2>
                    <p>@_successAnnouncement</p>
                </section>
            }

            @if (_validationIssues.Count > 0)
            {
                <section class="srs-catalogue__panel srs-catalogue__panel--danger"
                         data-testid="catalogue-validation-summary"
                         @ref="_validationSummary"
                         role="alert"
                         aria-live="assertive"
                         tabindex="-1">
                    <h2>@LocalizedUiText.Get("Review catalogue or policy values")</h2>
                    <p class="srs-catalogue__code">@_reasonCode</p>
                    <ul>
                        @foreach (var issue in _validationIssues)
                        {
                            <li><a href="#@issue.ControlId">@issue.Message</a></li>
                        }
                    </ul>
                </section>
            }

            <section class="srs-catalogue__panel" aria-labelledby="version-list-heading">
                <div class="srs-catalogue__heading-row">
                    <div>
                        <p class="srs-catalogue__eyebrow">@LocalizedUiText.Get("Immutable history")</p>
                        <h2 id="version-list-heading">@LocalizedUiText.Get("Version and status list")</h2>
                    </div>
                    <span class="srs-catalogue__disclaimer">
                        @LocalizedUiText.Get("Curated demo subset — locally assigned credits and fixture flags remain explicitly synthetic.")
                    </span>
                </div>
                <div class="srs-catalogue__table-region"
                     role="region"
                     aria-label="@(LocalizedUiText.Get("Catalogue versions"))"
                     tabindex="0">
                    <table>
                        <caption>@_versions.Count @LocalizedUiText.Get("catalogue versions")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@LocalizedUiText.Get("Version")</th>
                                <th scope="col">@LocalizedUiText.Get("Scope")</th>
                                <th scope="col">@LocalizedUiText.Get("Lifecycle")</th>
                                <th scope="col">@LocalizedUiText.Get("Source")</th>
                                <th scope="col">@LocalizedUiText.Get("Published")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var version in _versions)
                            {
                                <tr>
                                    <td><strong>@version.Version</strong></td>
                                    <td>@version.Scope</td>
                                    <td>@version.State</td>
                                    <td>@version.Source</td>
                                    <td>@version.PublishedAtUtc.ToString("dd MMM yyyy HH:mm 'UTC'", CultureInfo.CurrentCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="srs-catalogue__workspace">
                <section class="srs-catalogue__panel" aria-labelledby="catalogue-draft-heading">
                    <div class="srs-catalogue__heading-row">
                        <div>
                            <p class="srs-catalogue__eyebrow">@LocalizedUiText.Get("Catalogue draft")</p>
                            <h2 id="catalogue-draft-heading">@_draft?.Scope @LocalizedUiText.Get("programme snapshot")</h2>
                        </div>
                        <span class="srs-catalogue__status">@_draft?.State</span>
                    </div>
                    <dl class="srs-catalogue__facts">
                        <div><dt>@LocalizedUiText.Get("Draft version")</dt><dd><code>@_draft?.RowVersion</code></dd></div>
                        <div><dt>@LocalizedUiText.Get("Content hash")</dt><dd><code>@_draft?.CanonicalContentHash</code></dd></div>
                        <div><dt>@LocalizedUiText.Get("Courses")</dt><dd>@(_draft?.Courses.Count ?? 0)</dd></div>
                    </dl>

                    <form class="srs-catalogue__subpanel"
                          data-testid="catalogue-subject-editor"
                          @onsubmit="SaveSubjectAsync"
                          @onsubmit:preventDefault>
                        <h3>@LocalizedUiText.Get("Add or update a roadmap subject")</h3>
                        <p>@LocalizedUiText.Get("Every subject is exactly 3 credits. First-term subjects cannot have prerequisites.")</p>
                        <div class="srs-catalogue__field-grid">
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Subject code")
                                <input required maxlength="50" @bind="_subjectCode" />
                            </label>
                            <label class="srs-catalogue__field srs-catalogue__field--wide">
                                @LocalizedUiText.Get("Subject title")
                                <input required maxlength="300" @bind="_subjectTitle" />
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Recommended term")
                                <input type="number" min="1" max="12" required @bind="_recommendedTerm" />
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Level")
                                <input type="number" min="1" max="8" required @bind="_subjectLevel" />
                            </label>
                            <label class="srs-catalogue__field srs-catalogue__field--wide">
                                @LocalizedUiText.Get("Prerequisites")
                                <input placeholder="CS101, MA101" @bind="_subjectPrerequisites" />
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Cohort")
                                <input placeholder="2026" @bind="_subjectCohort" />
                            </label>
                            <label class="srs-catalogue__field">
                                <input type="checkbox" @bind="_subjectRequired" />
                                @LocalizedUiText.Get("Required subject")
                            </label>
                        </div>
                        <p><strong>@LocalizedUiText.Get("Exactly 3 credits")</strong></p>
                        <button type="submit" disabled="@(_draft is null || _isSavingSubject)">
                            @(_isSavingSubject ? LocalizedUiText.Get("Saving subject…") : LocalizedUiText.Get("Save subject and roadmap"))
                        </button>
                    </form>

                    <div class="srs-catalogue__course-list" aria-label="@(LocalizedUiText.Get("Curated courses"))">
                        @foreach (var course in _draft?.Courses ?? [])
                        {
                            <article class="srs-catalogue__course"
                                     id="@($"course-{course.Code}")"
                                     data-testid="catalogue-course">
                                <div>
                                    <h3>@course.Code — @course.Title</h3>
                                    <p>@course.Credits @LocalizedUiText.Get("credits ·") @(course.Active ? LocalizedUiText.Get("Active") : LocalizedUiText.Get("Inactive"))</p>
                                </div>
                                <div class="srs-catalogue__provenance">
                                    <strong>@SourceKindLabel(course.Provenance.SourceKind)</strong>
                                    <span>@LocalizedUiText.Get("Accessed") @course.Provenance.AccessedOn.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</span>
                                    <a href="@course.Provenance.SourceReference">@LocalizedUiText.Get("Open source reference")</a>
                                    <span>
                                        @LocalizedUiText.Get("Synthetic fields:")
                                        @string.Join(", ", course.Provenance.SyntheticFields)
                                    </span>
                                </div>
                            </article>
                        }
                    </div>

                    <form class="srs-catalogue__subpanel"
                          @onsubmit="CreateImportAsync"
                          @onsubmit:preventDefault>
                        <h3>@LocalizedUiText.Get("Import catalogue evidence")</h3>
                        <div class="srs-catalogue__field-grid">
                            <label class="srs-catalogue__field srs-catalogue__field--wide">
                                @LocalizedUiText.Get("Source URL or reference")
                                <input id="catalogue-import-source"
                                       type="url"
                                       required
                                       @bind="_importSource" />
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Access date")
                                <input id="catalogue-import-accessed-on"
                                       type="date"
                                       required
                                       value="@_importAccessedOn"
                                       @oninput="eventArgs => _importAccessedOn = eventArgs.Value?.ToString() ?? string.Empty" />
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Server-verifiable content hash")
                                <input id="catalogue-import-hash"
                                       required
                                       @bind="_importHash" />
                            </label>
                            <label class="srs-catalogue__field srs-catalogue__field--wide">
                                @LocalizedUiText.Get("Synthetic field manifest")
                                <input id="catalogue-import-synthetic-fields"
                                       aria-describedby="synthetic-field-help"
                                       @bind="_importSyntheticFields" />
                                <span id="synthetic-field-help">
                                    @LocalizedUiText.Get("Comma-separated field names; do not hide local gap values.")
                                </span>
                            </label>
                        </div>
                        <button type="submit" disabled="@_isImporting">
                            @(_isImporting ? LocalizedUiText.Get("Creating import…") : LocalizedUiText.Get("Create import"))
                        </button>
                        @if (_currentImport is not null)
                        {
                            <p>
                                @LocalizedUiText.Get("Current import") <code>@_currentImport.Id</code>:
                                <strong>@_currentImport.State</strong>@LocalizedUiText.Get(", rowversion") <code>@_currentImport.RowVersion</code>
                            </p>
                        }
                    </form>

                    <div class="srs-catalogue__actions">
                        <button type="button"
                                disabled="@(_isValidating || _draft is null)"
                                @onclick="ValidateCatalogueAsync">
                            @(_isValidating ? LocalizedUiText.Get("Validating…") : LocalizedUiText.Get("Validate catalogue"))
                        </button>
                        <button type="button"
                                @ref="_publishTrigger"
                                disabled="@(_previewToken is null || _isPublishing)"
                                @onclick="OpenPublishConfirmation">
                            @LocalizedUiText.Get("Publish catalogue")
                        </button>
                    </div>
                </section>

                <section class="srs-catalogue__panel" aria-labelledby="policy-editor-heading">
                    <div class="srs-catalogue__heading-row">
                        <div>
                            <p class="srs-catalogue__eyebrow">@LocalizedUiText.Get("Typed policy")</p>
                            <h2 id="policy-editor-heading">@_policy?.Version</h2>
                        </div>
                        <span class="srs-catalogue__status">@_policy?.State</span>
                    </div>
                    <p>
                        @LocalizedUiText.Get("Values are typed data only. Scripts and executable expressions are not accepted.")
                    </p>
                    <form @onsubmit="SavePolicyAsync" @onsubmit:preventDefault>
                        <div class="srs-catalogue__field-grid">
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Normal maximum credits")
                                <input id="normal-max-credits"
                                       inputmode="decimal"
                                       aria-invalid="@InvalidAria("normal-max-credits")"
                                       aria-describedby="@DescribedBy("normal-max-credits")"
                                       @bind="_normalMaxCredits" />
                                @FieldError("normal-max-credits")
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("GPA-below-2.0 maximum credits")
                                <input id="probation-max-credits"
                                       inputmode="decimal"
                                       aria-invalid="@InvalidAria("probation-max-credits")"
                                       aria-describedby="@DescribedBy("probation-max-credits")"
                                       @bind="_probationMaxCredits" />
                                @FieldError("probation-max-credits")
                            </label>
                        </div>
                        <button type="submit" disabled="@_isSavingPolicy">
                            @(_isSavingPolicy ? LocalizedUiText.Get("Saving…") : LocalizedUiText.Get("Save policy draft"))
                        </button>
                    </form>

                    <section class="srs-catalogue__subpanel" aria-labelledby="simulation-heading">
                        <h3 id="simulation-heading">@LocalizedUiText.Get("Deterministic policy simulation")</h3>
                        <div class="srs-catalogue__field-grid">
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Student context fixture")
                                <input id="simulation-fixture"
                                       required
                                       @bind="_simulationFixture" />
                            </label>
                            <label class="srs-catalogue__field">
                                @LocalizedUiText.Get("Requested course codes")
                                <input id="simulation-courses"
                                       @bind="_simulationCourses" />
                            </label>
                        </div>
                        <button type="button"
                                disabled="@(_isSimulating || _policy is null)"
                                @onclick="SimulatePolicyAsync">
                            @(_isSimulating ? LocalizedUiText.Get("Simulating…") : LocalizedUiText.Get("Simulate policy"))
                        </button>
                        <p>@LocalizedUiText.Get("Simulation does not publish or save changes.")</p>
                        @if (_simulation is not null)
                        {
                            <div class="srs-catalogue__simulation"
                                 role="status"
                                 aria-live="polite">
                                <h4>@(_simulation.Eligible ? LocalizedUiText.Get("Eligible") : LocalizedUiText.Get("Not eligible"))</h4>
                                <p>@LocalizedUiText.Get("Policy version") @_simulation.PolicyVersion</p>
                                <ul>
                                    @foreach (var rule in _simulation.RuleResults)
                                    {
                                        <li>
                                            <strong>@rule.RuleCode:</strong>
                                            <span>@rule.Explanation</span>
                                            <span>@SourceKindLabel(rule.SourceKind)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </section>
                </section>
            </div>

            @if (_catalogueValidation is not null)
            {
                <section class="srs-catalogue__panel @(_catalogueValidation.Valid ? "srs-catalogue__panel--success" : "srs-catalogue__panel--danger")"
                         aria-labelledby="catalogue-findings-heading"
                         aria-live="polite">
                    <h2 id="catalogue-findings-heading">
                        @(_catalogueValidation.Valid
                            ? "Catalogue validation passed"
                            : "Catalogue validation findings")
                    </h2>
                    @if (_catalogueValidation.Errors.Count > 0)
                    {
                        <ul>
                            @foreach (var error in _catalogueValidation.Errors)
                            {
                                <li>
                                    <strong>@error.Code</strong>
                                    <span>@error.Message</span>
                                    @if (error.Code == "PREREQUISITE_CYCLE")
                                    {
                                        <span class="srs-catalogue__cycle-links">
                                            @foreach (var courseCode in CycleCodes(error.Message))
                                            {
                                                <a data-testid="cycle-edit-link"
                                                   href="@($"#course-{courseCode}")">
                                                    @LocalizedUiText.Get("Edit") @courseCode
                                                </a>
                                            }
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (_catalogueValidation.Valid)
                    {
                        <p>
                            @LocalizedUiText.Get("Preview is bound to actor, scope, content hash, dependencies, rowversion, and expiry. It is not publication authority.")
                        </p>
                    }
                </section>
            }
        }
    </main>

    @if (_showPublishConfirmation)
    {
        <div data-testid="publish-catalogue-dialog">
            <ConfirmationDialog IsOpen="true"
                                DialogId="publish-catalogue-dialog"
                                TitleId="publish-catalogue-dialog-title"
                                DescriptionId="publish-catalogue-dialog-description"
                                Title="@(LocalizedUiText.Get("Publish catalogue"))"
                                Message="@(LocalizedUiText.Get("Publish one immutable version using the current draft rowversion and bound preview? The server will revalidate and choose one winner."))"
                                ConfirmLabel="@(LocalizedUiText.Get("Confirm publish"))"
                                CancelLabel="@(LocalizedUiText.Get("Cancel"))"
                                IsBusy="@_isPublishing"
                                BusyLabel="@(LocalizedUiText.Get("Publishing catalogue…"))"
                                OnConfirm="PublishCatalogueAsync"
                                OnCancel="ClosePublishConfirmation"
                                FocusRestoreRequested="RestorePublishFocusAsync" />
        </div>
    }
</div>

@code {
    private const string LoadingState = "loading";
    private const string EmptyState = "empty";
    private const string SuccessState = "success";
    private const string ValidationErrorState = "validation-error";
    private const string ServiceErrorState = "service-error";
    private const string UnauthorizedState = "unauthorized";
    private const string SessionExpiredState = "session-expired";
    private const string StaleState = "stale";
    private const string OfflineState = "offline";

    private static readonly IReadOnlyList<RoleNavigation.NavigationItem>
        AdministrationNavigation =
        [
            new(LocalizedUiText.Get("Dashboard"), "/admin"),
            new(LocalizedUiText.Get("Terms"), "/admin/terms"),
            new(LocalizedUiText.Get("Catalogue"), "/admin/catalogue", IsActive: true),
            new(LocalizedUiText.Get("Offerings"), "/admin/offerings")
        ];

    private readonly List<CatalogueVersionSummaryDto> _versions = [];
    private readonly List<ValidationIssue> _validationIssues = [];
    private ElementReference _validationSummary;
    private ElementReference _stateHeading;
    private ElementReference _publishTrigger;
    private string _state = LoadingState;
    private string _reasonCode = "SERVICE_UNAVAILABLE";
    private string _safeMessage = LocalizedUiText.Get("Catalogue administration could not be loaded.");
    private string? _referenceId;
    private string? _currentVersion;
    private string? _successAnnouncement;
    private CatalogueDraftDto? _draft;
    private ImportBatchDto? _currentImport;
    private PolicySetAdminDto? _policy;
    private CatalogueValidationResult? _catalogueValidation;
    private PolicySimulationResult? _simulation;
    private string? _previewToken;
    private string _normalMaxCredits = "18";
    private string _probationMaxCredits = "12";
    private string _importSource = string.Empty;
    private string _importAccessedOn = "2026-07-13";
    private string _importHash = string.Empty;
    private string _importSyntheticFields = LocalizedUiText.Get("Credits, IsActive");
    private string _simulationFixture = "ACTIVE-96-CREDITS";
    private string _simulationCourses = "DS413";
    private string _subjectCode = string.Empty;
    private string _subjectTitle = string.Empty;
    private string _subjectPrerequisites = string.Empty;
    private string _subjectCohort = "2026";
    private int _recommendedTerm = 1;
    private int _subjectLevel = 1;
    private bool _subjectRequired = true;
    private bool _isSavingSubject;
    private bool _isImporting;
    private bool _isValidating;
    private bool _isSavingPolicy;
    private bool _isSimulating;
    private bool _isPublishing;
    private bool _showPublishConfirmation;
    private bool _focusValidationSummary;
    private bool _focusStateHeading;

    private string CurrentStateFixture => _state switch
    {
        LoadingState => "ADM-05-COMP-STATE-LOADING",
        EmptyState => "ADM-05-COMP-STATE-EMPTY",
        SuccessState => "ADM-05-COMP-STATE-SUCCESS",
        ValidationErrorState => "ADM-05-COMP-STATE-VALIDATION-ERROR",
        ServiceErrorState => "ADM-05-COMP-STATE-SERVICE-ERROR",
        UnauthorizedState => "ADM-05-COMP-STATE-UNAUTHORIZED",
        SessionExpiredState => "ADM-05-COMP-STATE-SESSION-EXPIRED",
        StaleState => "ADM-05-COMP-STATE-STALE",
        OfflineState => "ADM-05-COMP-STATE-OFFLINE",
        _ => "ADM-05-COMP-STATE-SERVICE-ERROR"
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusValidationSummary)
        {
            _focusValidationSummary = false;
            await _validationSummary.FocusAsync();
        }

        if (_focusStateHeading)
        {
            _focusStateHeading = false;
            await _stateHeading.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        _state = LoadingState;
        ResetFeedback();
        try
        {
            var programsTask = CatalogueApi.ListProgramsAsync();
            var versionsTask = CatalogueApi.ListVersionsAsync();
            var policiesTask = CatalogueApi.ListPoliciesAsync();
            await Task.WhenAll(
                programsTask,
                versionsTask,
                policiesTask);

            var programs = await programsTask;
            var versions = await versionsTask;
            var policies = await policiesTask;
            var failure = FirstFailure(programs, versions, policies);
            if (failure is not null)
            {
                ApplyFailure(failure.Value.StatusCode, failure.Value.Error);
                return;
            }

            _versions.Clear();
            _versions.AddRange(versions.Value!.Items);
            _policy = policies.Value!.Items.FirstOrDefault();
            var baseVersion = _versions.FirstOrDefault(item =>
                string.Equals(item.State, "published", StringComparison.OrdinalIgnoreCase))
                ?? _versions.FirstOrDefault();
            if (baseVersion is not null)
            {
                var draft = await CatalogueApi.CreateDraftAsync(new(
                    baseVersion.Id,
                    LocalizedUiText.Get("Open the editable manual-testing catalogue draft"),
                    Guid.NewGuid()));
                if (!draft.IsSuccess || draft.Value is null)
                {
                    ApplyFailure(draft.StatusCode, draft.Error);
                    return;
                }

                _draft = draft.Value;
            }
            _currentImport = null;
            ApplyPolicyEditor();
            _state = _versions.Count == 0 && programs.Value!.Items.Count == 0
                ? EmptyState
                : SuccessState;
        }
        catch (HttpRequestException)
        {
            _state = OfflineState;
            _reasonCode = "OFFLINE";
            _safeMessage = LocalizedUiText.Get("The browser cannot reach catalogue administration. No action was queued.");
        }
    }

    private async Task SaveSubjectAsync()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_subjectCode) ||
            string.IsNullOrWhiteSpace(_subjectTitle) || _recommendedTerm < 1 ||
            _subjectLevel < 1)
        {
            SetValidation("VALIDATION_ERROR", [new(
                "catalogue-subject-editor",
                LocalizedUiText.Get("Subject code, title, level, and recommended term are required."))]);
            return;
        }

        var prerequisites = SplitValues(_subjectPrerequisites);
        if (_recommendedTerm == 1 && prerequisites.Count > 0)
        {
            SetValidation("FIRST_TERM_PREREQUISITE_FORBIDDEN", [new(
                "catalogue-subject-editor",
                LocalizedUiText.Get("First-term subjects cannot have prerequisites."))]);
            return;
        }
        if (!DateOnly.TryParse(_importAccessedOn, out var sourceAccessedOn))
        {
            SetValidation("SOURCE_DATE_INVALID", [new(
                "catalogue-subject-editor",
                LocalizedUiText.Get("Enter the authoritative source access date before saving the subject."))]);
            return;
        }

        _isSavingSubject = true;
        ResetFeedback();
        var code = _subjectCode.Trim().ToUpperInvariant();
        var provenance = new CatalogueFieldProvenanceDto(
            "local-development-manual-subject",
            sourceAccessedOn,
            "synthetic-demo",
            ["Credits", "Active", "Level", "RecommendedTerm", "Required", "Cohort"]);
        var existing = _draft.Courses.FirstOrDefault(item =>
            string.Equals(item.Code, code, StringComparison.OrdinalIgnoreCase));
        var result = await CatalogueApi.UpdateDraftAsync(
            _draft.Id,
            new(
                _draft.RowVersion,
                LocalizedUiText.Get("Add or update a three-credit roadmap subject"),
                "manual-admin-editor",
                [
                    new(
                        "upsert-course",
                        Course: new(
                            existing?.Id ?? Guid.NewGuid(),
                            code,
                            _subjectTitle.Trim(),
                            3m,
                            true,
                            provenance,
                            existing?.RowVersion ?? string.Empty)),
                    new(
                        "upsert-curriculum-course",
                        CurriculumCourse: new(
                            _draft.Scope,
                            code,
                            _subjectLevel,
                            _recommendedTerm,
                            _subjectRequired,
                            string.IsNullOrWhiteSpace(_subjectCohort)
                                ? null
                                : _subjectCohort.Trim(),
                            provenance)),
                    new(
                        "set-prerequisites",
                        CourseCode: code,
                        RequiredCourseCodes: prerequisites,
                        Provenance: provenance),
                ]));
        _isSavingSubject = false;
        if (!result.IsSuccess || result.Value is null)
        {
            ApplyFailure(result.StatusCode, result.Error);
            return;
        }

        _draft = result.Value;
        _previewToken = null;
        _successAnnouncement = LocalizedUiText.Get("Subject and roadmap saved. Validate before publishing.");
        _state = SuccessState;
        _subjectCode = string.Empty;
        _subjectTitle = string.Empty;
        _subjectPrerequisites = string.Empty;
    }

    private async Task CreateImportAsync()
    {
        if (_draft is null
            || !DateOnly.TryParseExact(
                _importAccessedOn,
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var accessedOn)
            || string.IsNullOrWhiteSpace(_importSource)
            || string.IsNullOrWhiteSpace(_importHash))
        {
            SetValidation(
                "VALIDATION_ERROR",
                [
                    new(
                        "catalogue-import-source",
                        LocalizedUiText.Get("Source, access date, and content hash are required."))
                ]);
            return;
        }

        _isImporting = true;
        ResetFeedback();
        var result = await CatalogueApi.CreateImportAsync(
            new(
                _draft.Id,
                _importSource.Trim(),
                accessedOn,
                _importHash.Trim(),
                SplitValues(_importSyntheticFields),
                Guid.NewGuid()));
        _isImporting = false;
        if (result.IsSuccess && result.Value is not null)
        {
            _currentImport = result.Value;
            _successAnnouncement = LocalizedUiText.Get("Import evidence was accepted by the server.");
            _state = SuccessState;
            return;
        }

        ApplyFailure(result.StatusCode, result.Error);
    }

    private async Task SavePolicyAsync()
    {
        if (_policy is null)
        {
            return;
        }

        var issues = new List<ValidationIssue>();
        if (!decimal.TryParse(
                _normalMaxCredits,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var normal)
            || normal <= 0)
        {
            issues.Add(new(
                "normal-max-credits",
                LocalizedUiText.Get("Normal maximum credits must be a positive typed number.")));
        }

        if (!decimal.TryParse(
                _probationMaxCredits,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var probation)
            || probation <= 0)
        {
            issues.Add(new(
                "probation-max-credits",
                LocalizedUiText.Get("Probation maximum credits must be a positive typed number.")));
        }

        if (issues.Count > 0)
        {
            SetValidation("RULE_VALUE_TYPE_MISMATCH", issues);
            return;
        }

        _isSavingPolicy = true;
        ResetFeedback();
        var operations = _policy.Rules
            .Where(rule => rule.Code is "NORMAL_MAX_CREDITS" or "PROBATION_MAX_CREDITS")
            .Select(rule =>
            {
                var value = rule.Code == "NORMAL_MAX_CREDITS" ? normal : probation;
                return new PolicySetOperation(
                    "upsert-rule",
                    rule with { Value = JsonSerializer.SerializeToElement(value) });
            })
            .ToArray();
        var result = await CatalogueApi.UpdatePolicyAsync(
            _policy.Id,
            new(_policy.RowVersion, LocalizedUiText.Get("Update typed demo credit boundaries"), operations));
        _isSavingPolicy = false;
        if (result.IsSuccess && result.Value is not null)
        {
            _policy = result.Value;
            _previewToken = null;
            _successAnnouncement =
                LocalizedUiText.Get("Policy draft saved. Any earlier publication preview was invalidated.");
            return;
        }

        ApplyFailure(result.StatusCode, result.Error);
    }

    private async Task ValidateCatalogueAsync()
    {
        if (_draft is null)
        {
            return;
        }

        _isValidating = true;
        ResetFeedback();
        var import = _currentImport;
        if (import is null)
        {
            SetValidation("IMPORT_REQUIRED", [new(
                "catalogue-import-source",
                LocalizedUiText.Get("Create import evidence before validating the catalogue."))]);
            _isValidating = false;
            return;
        }
        var result = await CatalogueApi.ValidateImportAsync(
            import.Id,
            new(
                import.RowVersion,
                _draft.RowVersion));
        _isValidating = false;
        if (result.IsSuccess && result.Value is not null)
        {
            _catalogueValidation = result.Value;
            _previewToken = result.Value.Valid ? result.Value.PreviewToken : null;
            _state = result.Value.Valid ? SuccessState : ValidationErrorState;
            _reasonCode = result.Value.Valid
                ? "VALIDATED"
                : result.Value.Errors.FirstOrDefault()?.Code ?? "VALIDATION_ERROR";
            return;
        }

        ApplyFailure(result.StatusCode, result.Error);
    }

    private async Task SimulatePolicyAsync()
    {
        if (_policy is null || string.IsNullOrWhiteSpace(_simulationFixture))
        {
            return;
        }

        _isSimulating = true;
        ResetFeedback();
        var result = await CatalogueApi.SimulatePolicyAsync(
            _policy.Id,
            new(
                _policy.Id,
                _simulationFixture.Trim(),
                SplitValues(_simulationCourses)));
        _isSimulating = false;
        if (result.IsSuccess && result.Value is not null)
        {
            _simulation = result.Value;
            _successAnnouncement =
                LocalizedUiText.Get("Simulation completed deterministically; no durable change was made.");
            return;
        }

        ApplyFailure(result.StatusCode, result.Error);
    }

    private void OpenPublishConfirmation() =>
        _showPublishConfirmation = _previewToken is not null;

    private void ClosePublishConfirmation() =>
        _showPublishConfirmation = false;

    private async Task PublishCatalogueAsync()
    {
        if (_draft is null || _previewToken is null)
        {
            return;
        }

        _isPublishing = true;
        ResetFeedback();
        if (_currentImport is null)
        {
            _isPublishing = false;
            SetValidation("IMPORT_REQUIRED", [new(
                "catalogue-import-source",
                LocalizedUiText.Get("Create and validate import evidence before publishing."))]);
            return;
        }
        var result = await CatalogueApi.PublishImportAsync(
            _currentImport.Id,
            new(_draft.RowVersion, _previewToken, Guid.NewGuid()));
        _isPublishing = false;
        _showPublishConfirmation = false;
        if (result.IsSuccess && result.Value is not null)
        {
            _versions.Insert(0, result.Value);
            _previewToken = null;
            _catalogueValidation = null;
            _state = SuccessState;
            _successAnnouncement = LocalizedUiText.Get("Published immutable catalogue version");
            return;
        }

        ApplyFailure(result.StatusCode, result.Error);
    }

    private async Task RefreshAndRevalidateAsync()
    {
        await LoadAsync();
        if (_state is SuccessState)
        {
            await ValidateCatalogueAsync();
        }
    }

    private Task RestorePublishFocusAsync() => _publishTrigger.FocusAsync().AsTask();

    private void ApplyPolicyEditor()
    {
        if (_policy is null)
        {
            return;
        }

        _normalMaxCredits = RuleNumber("NORMAL_MAX_CREDITS", "18");
        _probationMaxCredits = RuleNumber("PROBATION_MAX_CREDITS", "12");
    }

    private string RuleNumber(string code, string fallback)
    {
        var rule = _policy?.Rules.FirstOrDefault(item => item.Code == code);
        return rule?.Value.ValueKind is JsonValueKind.Number
            && rule.Value.TryGetDecimal(out var value)
                ? value.ToString(CultureInfo.InvariantCulture)
                : fallback;
    }

    private void ApplyFailure(HttpStatusCode status, ApiError? error)
    {
        _reasonCode = error?.Code
            ?? (status is HttpStatusCode.ServiceUnavailable
                ? "SERVICE_UNAVAILABLE"
                : "UNEXPECTED_ERROR");
        _safeMessage = error?.Message ?? LocalizedUiText.Get("The request could not be completed safely.");
        _referenceId = error?.CorrelationId;
        _currentVersion = error?.CurrentVersion;
        _state = status switch
        {
            HttpStatusCode.Unauthorized => SessionExpiredState,
            HttpStatusCode.Forbidden => UnauthorizedState,
            HttpStatusCode.Conflict when
                _reasonCode is "STALE_PREVIEW" or "STALE_VERSION" => StaleState,
            HttpStatusCode.BadRequest => ValidationErrorState,
            _ => ServiceErrorState
        };
        _focusStateHeading = _state is
            UnauthorizedState or SessionExpiredState or StaleState;
    }

    private static (HttpStatusCode StatusCode, ApiError? Error)? FirstFailure(
        AcademicApiResult<Page<ProgramAdminDto>> programs,
        AcademicApiResult<Page<CatalogueVersionSummaryDto>> versions,
        AcademicApiResult<Page<PolicySetAdminDto>> policies)
    {
        if (!programs.IsSuccess) return (programs.StatusCode, programs.Error);
        if (!versions.IsSuccess) return (versions.StatusCode, versions.Error);
        if (!policies.IsSuccess) return (policies.StatusCode, policies.Error);
        return null;
    }

    private void SetValidation(string code, IReadOnlyList<ValidationIssue> issues)
    {
        _validationIssues.Clear();
        _validationIssues.AddRange(issues);
        _reasonCode = code;
        _state = ValidationErrorState;
        _focusValidationSummary = true;
        _successAnnouncement = null;
    }

    private void ResetFeedback()
    {
        _validationIssues.Clear();
        _reasonCode = "AVAILABLE";
        _safeMessage = string.Empty;
        _referenceId = null;
        _currentVersion = null;
        _successAnnouncement = null;
    }

    private RenderFragment FieldError(string controlId) => @<text>
        @if (ErrorFor(controlId) is { } error)
        {
            <span class="srs-catalogue__field-error" id="@(controlId)-error">@error</span>
        }
    </text>;

    private string? ErrorFor(string controlId) =>
        _validationIssues.FirstOrDefault(issue => issue.ControlId == controlId)?.Message;

    private string? InvalidAria(string controlId) =>
        ErrorFor(controlId) is null ? null : "true";

    private string? DescribedBy(string controlId) =>
        ErrorFor(controlId) is null ? null : $"{controlId}-error";

    private static IReadOnlyList<string> SplitValues(string value) =>
        value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static IReadOnlyList<string> CycleCodes(string message) =>
        message.Split("->", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal)
            .ToArray();

    private static string SourceKindLabel(string sourceKind) =>
        sourceKind == "official-source"
            ? LocalizedUiText.Get("Official source")
            : LocalizedUiText.Get("Synthetic demo");

    private sealed record ValidationIssue(string ControlId, string Message);
}
