@page "/admin/approvals"
@page "/staff/approvals"
@using System.Net
@using StudentRegistration.Client.Components.Display
@using StudentRegistration.Client.Components.Feedback
@using StudentRegistration.Client.Components.Layout
@using StudentRegistration.Client.Components.Navigation
@using StudentRegistration.Client.Components.Registration
@using StudentRegistration.Client.Features.Academics
@using StudentRegistration.Client.Features.Registration
@inject AcademicApiClient AcademicApi
@inject RegistrationApprovalApiClient ApprovalApi
@inject NavigationManager Navigation

<PageTitle>Registration approvals | Student Registration</PageTitle>

@if (_shellContext is null)
{
    <main id="main-content" class="srs-approvals" aria-busy="true">
        <h1>Registration approvals</h1>
        <p role="status">Loading the authorized approval queue…</p>
    </main>
}
else
{
    <AppShell Context="@_shellContext"
              MainContentId="main-content"
              SkipLinkLabel="Skip to main content"
              BrandLogoSource="/brand/aastmt-logo.png"
              BrandLogoAccessibleName="Arab Academy for Science, Technology and Maritime Transport"
              ServerDateTimeLabel="Server date and time"
              TeachingTermLabel="Teaching term"
              RegistrationTermLabel="Registration term"
              RegistrationWindowLabel="Registration window"
              NoTeachingTermLabel="No current teaching term"
              NoRegistrationTermLabel="No current registration term"
              NoRegistrationWindowLabel="No registration window"
              AuthorizedRolesLabel="Authorized roles"
              ActiveRoleLabel="Active role"
              SessionLabel="Session"
              ServiceLabel="Service"
              SupportLinkLabel="Open support"
              LoadingLabel="Loading registration approvals">
        <Navigation>
            <RoleNavigation AccessibleName="@(_admin ? "Administration navigation" : "Staff navigation")"
                            Items="@NavigationItems" />
        </Navigation>
        <ChildContent>
            <div class="srs-approvals" data-route-id="@(_admin ? "ADM-10" : "STF-05")" data-state="@StateName">
                <PageHeader HeadingId="approval-heading"
                            Eyebrow="Seat-hold decisions"
                            Heading="Registration approvals"
                            Description="Review each requested subject. A plan is registered only after every subject is approved; one rejection releases all held seats." />

                @if (_loading)
                {
                    <p role="status" aria-live="polite">Loading pending subject decisions…</p>
                }
                else if (_error is not null)
                {
                    <section class="srs-approvals__notice" role="alert">
                        <h2>Approval queue unavailable</h2>
                        <p><strong>@_error.Code</strong> @_error.Message</p>
                        <button type="button" @onclick="LoadQueueAsync">Retry</button>
                    </section>
                }
                else if (_queue is null || _queue.Items.Count == 0)
                {
                    <SurfaceCard HeadingId="approval-empty" Heading="No pending decisions"
                                 Description="There are no subject seat holds in your authorized scope.">
                        <ChildContent>
                            <p>Refresh later when students submit registration plans.</p>
                        </ChildContent>
                        <Actions>
                            <button type="button" @onclick="LoadQueueAsync">Refresh queue</button>
                        </Actions>
                    </SurfaceCard>
                }
                else
                {
                    <div class="srs-approvals__toolbar">
                        <p role="status"><strong>@_queue.TotalCount</strong> pending subject decisions</p>
                        <button type="button" disabled="@_deciding" @onclick="LoadQueueAsync">Refresh queue</button>
                    </div>
                    <div class="srs-approvals__grid">
                        @foreach (var row in _queue.Items)
                        {
                            <SurfaceCard HeadingId="@($"approval-{row.Line.LineId:D}")"
                                         Heading="@($"{row.Line.CourseCode} — {row.Line.SubjectTitle}")"
                                         Description="@($"{row.StudentDisplayName} · {row.StudentUniversityId}")">
                                <ChildContent>
                                    <div class="srs-approvals__meta">
                                        <ApprovalStatusBadge State="ApprovalStatusBadge.ApprovalState.PendingApproval"
                                                               Text="Pending approval" />
                                        @if (row.Overload)
                                        {
                                            <span class="srs-approvals__overload">CGPA-qualified overload</span>
                                        }
                                    </div>
                                    <dl class="srs-approvals__facts">
                                        <div><dt>Subject credits</dt><dd>@row.Line.Credits</dd></div>
                                        <div><dt>Requested total</dt><dd>@row.RequestedCredits</dd></div>
                                        <div><dt>Current CGPA</dt><dd>@row.CurrentCgpa.ToString("0.00")</dd></div>
                                        <div><dt>Submitted</dt><dd>@row.SubmittedAtUtc.ToString("g") UTC</dd></div>
                                        <div><dt>Window closes</dt><dd>@row.WindowClosesAtUtc.ToString("g") UTC</dd></div>
                                    </dl>
                                    <CapacityBreakdown AccessibleName="@($"Capacity for {row.Line.CourseCode}")"
                                                       TotalLabel="Total" Total="@row.Line.Capacity.Capacity"
                                                       EnrolledLabel="Enrolled" Enrolled="@row.Line.Capacity.EnrolledCount"
                                                       HeldLabel="Held" Held="@row.Line.Capacity.HeldSeatCount"
                                                       AvailableLabel="Available" Available="@row.Line.Capacity.AvailableSeatCount" />
                                    <label for="@($"reason-{row.Line.LineId:D}")">Decision reason</label>
                                    <textarea id="@($"reason-{row.Line.LineId:D}")"
                                              value="@Reason(row.Line.LineId)"
                                              @oninput="eventArgs => SetReason(row.Line.LineId, eventArgs.Value?.ToString())"
                                              maxlength="500"
                                              disabled="@_deciding"></textarea>
                                    @if (_lineErrorId == row.Line.LineId)
                                    {
                                        <p class="srs-approvals__line-error" role="alert">@_lineError</p>
                                    }
                                </ChildContent>
                                <Actions>
                                    <button type="button" disabled="@_deciding"
                                            @onclick="() => ApproveAsync(row)">Approve subject</button>
                                    <button type="button" class="srs-approvals__reject" disabled="@_deciding"
                                            @onclick="() => RejectAsync(row)">Reject plan</button>
                                </Actions>
                            </SurfaceCard>
                        }
                    </div>
                }
            </div>
        </ChildContent>
    </AppShell>
}

@code {
    private readonly Dictionary<Guid, string> _reasons = [];
    private FrontendAppContextView? _shellContext;
    private RegistrationApprovalPageDto? _queue;
    private ApiError? _error;
    private Guid? _lineErrorId;
    private string? _lineError;
    private bool _admin;
    private bool _loading = true;
    private bool _deciding;

    private string StateName => _loading ? "loading" : _error is not null ? "error" : _queue?.Items.Count > 0 ? "success" : "empty";

    private IReadOnlyList<RoleNavigation.NavigationItem> NavigationItems => _admin
        ? [
            new("Dashboard", "/admin"),
            new("Catalogue", "/admin/catalogue"),
            new("Offerings", "/admin/offerings"),
            new("Approvals", "/admin/approvals", IsActive: true),
            new("Registrations", "/admin/registrations"),
          ]
        : [
            new("Staff home", "/staff"),
            new("Timetable", "/staff/timetable"),
            new("Availability", "/staff/availability"),
            new("Approvals", "/staff/approvals", IsActive: true),
          ];

    protected override async Task OnInitializedAsync()
    {
        _admin = new Uri(Navigation.Uri).AbsolutePath.StartsWith("/admin/", StringComparison.Ordinal);
        var context = await AcademicApi.GetAppContextAsync();
        if (!context.IsSuccess || context.Value is null || !HasExpectedRole(context.Value.ActiveRole))
        {
            _error = context.Error ?? new("FORBIDDEN", "The active role cannot access this approval queue.", "client");
            _loading = false;
            return;
        }

        _shellContext = RegistrationPageSupport.ToShellContext(context.Value);
        await LoadQueueAsync();
    }

    private async Task LoadQueueAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await ApprovalApi.ListAsync(_admin);
            if (result.IsSuccess && result.Value is not null)
            {
                _queue = result.Value;
            }
            else
            {
                _queue = null;
                _error = result.Error ?? new("APPROVAL_QUEUE_UNAVAILABLE", "The approval queue could not be loaded.", "client");
            }
        }
        catch (HttpRequestException)
        {
            _error = new("OFFLINE", "The browser cannot reach the approval service.", "client");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecideAsync(RegistrationApprovalQueueRowDto row, string decision)
    {
        var reason = Reason(row.Line.LineId).Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            _lineErrorId = row.Line.LineId;
            _lineError = "Enter a reason before making this decision.";
            return;
        }

        _deciding = true;
        _lineErrorId = null;
        _lineError = null;
        try
        {
            var result = await ApprovalApi.DecideAsync(
                _admin,
                row.SubmissionId,
                row.Line.LineId,
                new(decision, reason, row.SubmissionVersion, row.Line.RowVersion, Guid.NewGuid()));
            if (!result.IsSuccess)
            {
                _lineErrorId = row.Line.LineId;
                _lineError = $"{result.Error?.Code ?? "APPROVAL_FAILED"}: {result.Error?.Message ?? "Refresh and try again."}";
                return;
            }

            _reasons.Remove(row.Line.LineId);
            await LoadQueueAsync();
        }
        finally
        {
            _deciding = false;
        }
    }

    private Task ApproveAsync(RegistrationApprovalQueueRowDto row) => DecideAsync(row, "approve");

    private Task RejectAsync(RegistrationApprovalQueueRowDto row) => DecideAsync(row, "reject");

    private bool HasExpectedRole(string? role) => _admin
        ? string.Equals(role, "Admin", StringComparison.Ordinal)
        : role is "Lecturer" or "TeachingAssistant";

    private string Reason(Guid lineId) => _reasons.GetValueOrDefault(lineId, string.Empty);

    private void SetReason(Guid lineId, string? value) => _reasons[lineId] = value ?? string.Empty;
}
