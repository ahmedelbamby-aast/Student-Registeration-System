@page "/student/activate"
@inject IdentityApiClient IdentityApi
@inject NavigationManager Navigation

<PageTitle>@LocalizedUiText.Get("Activate Student account")</PageTitle>

<IdentityPageShell HeadingId="student-activation-heading"
                   Heading="@(LocalizedUiText.Get("Activate Student account"))"
                   Introduction="@(LocalizedUiText.Get("Use the University ID and initial credential issued for this demo, then choose your own password."))">
    <IdentityFeedback IsBusy="IsSubmitting"
                      BusyMessage="@(LocalizedUiText.Get("Activating the account once."))"
                      IsError="@(!string.IsNullOrWhiteSpace(_feedbackCode))"
                      Heading="@_feedbackHeading"
                      Message="@_feedbackMessage"
                      State="@_feedbackState"
                      Code="@_feedbackCode"
                      CorrelationId="@_correlationId" />

    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault data-testid="student-activation-form">
        <AccessibleValidationSummary SummaryId="student-activation-errors"
                                     Heading="@(LocalizedUiText.Get("Review the activation details"))"
                                     Errors="@_validationErrors" />

        <FormField InputId="activation-university-id"
                   Name="universityId"
                   Label="@(LocalizedUiText.Get("University ID"))"
                   Type="text"
                   autocomplete="username"
                   Required="true"
                   Disabled="IsSubmitting"
                   ErrorMessage="@ErrorFor("activation-university-id")"
                   @bind-Value="_universityId" />

        <FormField InputId="activation-initial-password"
                   Name="initialPassword"
                   Label="@(LocalizedUiText.Get("Initial PIN / password"))"
                   Description="@(LocalizedUiText.Get("This is a first-use activation credential, not a second factor."))"
                   Type="password"
                   autocomplete="current-password"
                   AllowSecretReveal="true"
                   Required="true"
                   Disabled="IsSubmitting"
                   ErrorMessage="@ErrorFor("activation-initial-password")"
                   @bind-Value="_initialPassword" />

        <FormField InputId="activation-new-password"
                   Name="newPassword"
                   Label="@(LocalizedUiText.Get("New password"))"
                   Description="@(LocalizedUiText.Get("Use 15 to 128 characters. Spaces and Unicode are allowed."))"
                   Type="password"
                   autocomplete="new-password"
                   AllowSecretReveal="true"
                   Required="true"
                   Disabled="IsSubmitting"
                   ErrorMessage="@ErrorFor("activation-new-password")"
                   @bind-Value="_newPassword" />

        <FormField InputId="activation-confirm-password"
                   Name="confirmPassword"
                   Label="@(LocalizedUiText.Get("Confirm new password"))"
                   Type="password"
                   autocomplete="new-password"
                   AllowSecretReveal="true"
                   Required="true"
                   Disabled="IsSubmitting"
                   ErrorMessage="@ErrorFor("activation-confirm-password")"
                   @bind-Value="_confirmPassword" />

        <AppButton Type="submit"
                   IsLoading="@IsSubmitting"
                   Disabled="@IsSubmitting"
                   LoadingAnnouncement="@(LocalizedUiText.Get("Activating the account once."))">
            @(IsSubmitting ? LocalizedUiText.Get("Activating…") : LocalizedUiText.Get("Activate account"))
        </AppButton>
    </form>
</IdentityPageShell>

@code {
    private string _universityId = string.Empty;
    private string _initialPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _feedbackCode;
    private string? _feedbackMessage;
    private string _feedbackHeading = LocalizedUiText.Get("Activation status");
    private string? _feedbackState;
    private string? _correlationId;
    private IReadOnlyList<AccessibleValidationSummary.ValidationItem> _validationErrors = [];

    private bool IsSubmitting { get; set; }

    private async Task SubmitAsync()
    {
        if (IsSubmitting || !Validate())
        {
            return;
        }

        ClearFeedback();
        IsSubmitting = true;
        try
        {
            var result = await IdentityApi.ActivateStudentAsync(
                new ActivateStudentRequest(
                    _universityId,
                    _initialPassword,
                    _newPassword));
            if (result.IsSuccess)
            {
                ClearSecrets();
                Navigation.NavigateTo("/student/login");
                return;
            }

            ApplyFailure(result.Error);
            ClearSecrets();
        }
        catch (HttpRequestException)
        {
            ApplyFailure(null);
            ClearSecrets();
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private bool Validate()
    {
        var errors = new List<AccessibleValidationSummary.ValidationItem>();
        if (string.IsNullOrWhiteSpace(_universityId))
        {
            errors.Add(new("activation-university-id", LocalizedUiText.Get("Enter your University ID.")));
        }

        if (string.IsNullOrEmpty(_initialPassword))
        {
            errors.Add(new("activation-initial-password", LocalizedUiText.Get("Enter the issued initial credential.")));
        }

        if (_newPassword.Length is < 15 or > 128)
        {
            errors.Add(new("activation-new-password", LocalizedUiText.Get("Use a password from 15 to 128 characters.")));
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            errors.Add(new("activation-confirm-password", LocalizedUiText.Get("The new passwords must match.")));
        }

        _validationErrors = errors;
        return errors.Count == 0;
    }

    private string? ErrorFor(string controlId) =>
        _validationErrors.FirstOrDefault(error => error.ControlId == controlId)?.Message;

    private void ApplyFailure(ApiError? error)
    {
        _feedbackCode = error?.Code ?? "SERVICE_UNAVAILABLE";
        _feedbackHeading = _feedbackCode is "ACTIVATION_FAILED" or "PASSWORD_REJECTED"
            ? LocalizedUiText.Get("Activation not accepted")
            : LocalizedUiText.Get("Activation service unavailable");
        _feedbackMessage = IdentityPageFeedback.SafeMessageFor(_feedbackCode);
        _feedbackState = IdentityPageFeedback.MapFailure(
            IdentityRouteStateMapper.StudentActivationRecord,
            _feedbackCode).ServiceState;
        _correlationId = error?.CorrelationId;
    }

    private void ClearSecrets()
    {
        _initialPassword = string.Empty;
        _newPassword = string.Empty;
        _confirmPassword = string.Empty;
    }

    private void ClearFeedback()
    {
        _feedbackCode = null;
        _feedbackMessage = null;
        _feedbackState = null;
        _correlationId = null;
    }
}
