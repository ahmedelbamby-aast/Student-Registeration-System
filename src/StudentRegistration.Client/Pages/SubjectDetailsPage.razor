@page "/student/subjects/{OfferingId:guid}"
@using System.Net
@using StudentRegistration.Client.Components.Layout
@using StudentRegistration.Client.Components.Navigation
@using StudentRegistration.Client.Features.Academics
@using StudentRegistration.Client.Features.Frontend.Models
@using StudentRegistration.Client.Features.Registration
@using StudentRegistration.Contracts.Registration
@inject AcademicApiClient AcademicApi
@inject RegistrationApiClient RegistrationApi

<PageTitle>@LocalizedUiText.Get("Subject details | Student Registration")</PageTitle>

@if (_initialLoading)
{
    <main class="srs-subject-details"
          id="main-content"
          data-route-id="STU-03"
          data-state="loading"
          data-contract-state="STU-03-COMP-STATE-LOADING"
          tabindex="-1">
        <h1>@LocalizedUiText.Get("Subject details")</h1>
        <section role="status" aria-live="polite" aria-busy="true">
            <h2>@LocalizedUiText.Get("Loading subject details")</h2>
            <p>@LocalizedUiText.Get("Refreshing the current eligibility, groups, capacity, and versions.")</p>
        </section>
    </main>
}
else if (_shellContext is not null)
{
    <AppShell Context="@_shellContext"
              MainContentId="main-content"
              SkipLinkLabel="@(LocalizedUiText.Get("Skip to main content"))"
              BrandLogoSource="/brand/aastmt-logo.png"
              BrandLogoAccessibleName="@(LocalizedUiText.Get("Arab Academy for Science, Technology and Maritime Transport"))"
              ServerDateTimeLabel="@(LocalizedUiText.Get("Server date and time"))"
              TeachingTermLabel="@(LocalizedUiText.Get("Teaching term"))"
              RegistrationTermLabel="@(LocalizedUiText.Get("Registration term"))"
              RegistrationWindowLabel="@(LocalizedUiText.Get("Registration window"))"
              NoTeachingTermLabel="@(LocalizedUiText.Get("No current teaching term"))"
              NoRegistrationTermLabel="@(LocalizedUiText.Get("No current registration term"))"
              NoRegistrationWindowLabel="@(LocalizedUiText.Get("No registration window"))"
              AuthorizedRolesLabel="@(LocalizedUiText.Get("Authorized roles"))"
              ActiveRoleLabel="@(LocalizedUiText.Get("Active role"))"
              SessionLabel="@(LocalizedUiText.Get("Session"))"
              ServiceLabel="@(LocalizedUiText.Get("Service"))"
              SupportLinkLabel="@(LocalizedUiText.Get("Open support"))"
              LoadingLabel="@(LocalizedUiText.Get("Loading subject details"))">
        <Navigation>
            <RoleNavigation AccessibleName="@(LocalizedUiText.Get("Student role navigation"))"
                            Items="@StudentNavigation" />
        </Navigation>
        <ChildContent>
            <div class="srs-subject-details"
                 data-route-id="STU-03"
                 data-state="@_state"
                 data-contract-state="@ContractState">
                <nav aria-label="@(LocalizedUiText.Get("Breadcrumb"))">
                    <a href="/student/subjects">@LocalizedUiText.Get("Available subjects")</a>
                    <span aria-hidden="true"> / </span>
                    <span>@LocalizedUiText.Get("Subject details")</span>
                </nav>
                <header class="srs-subject-details__intro">
                    <div>
                        <p class="srs-subject-details__eyebrow">@LocalizedUiText.Get("Student registration")</p>
                        <h1>@LocalizedUiText.Get("Subject details")</h1>
                        @if (_offering is not null)
                        {
                            <p>
                                <strong>@_offering.CourseCode</strong>
                                · @_offering.Title
                                · @Credits(_offering.Credits) @LocalizedUiText.Get("credits")
                            </p>
                        }
                    </div>
                    <a href="/student/subjects">@LocalizedUiText.Get("Return to discovery")</a>
                </header>

                @if (IsFailureState)
                {
                    <section class="srs-subject-details__state srs-subject-details__state--error"
                             aria-labelledby="subject-detail-error-heading"
                             role="@(_state is UnauthorizedState or SessionExpiredState ? "alert" : "status")"
                             aria-live="@(_state is UnauthorizedState or SessionExpiredState ? "assertive" : "polite")">
                        <h2 id="subject-detail-error-heading">@FailureHeading</h2>
                        <p><strong>@_reasonCode</strong></p>
                        <p>@_safeMessage</p>
                        @if (!string.IsNullOrWhiteSpace(_referenceId))
                        {
                            <p>@LocalizedUiText.Get("Reference:") <span>@_referenceId</span></p>
                        }
                        @if (_state is ServiceErrorState or OfflineState or StaleState)
                        {
                            <button type="button"
                                    disabled="@_requestLoading"
                                    @onclick="LoadDetailsAsync">
                                @LocalizedUiText.Get("Retry subject details")
                            </button>
                        }
                        <a href="/student/subjects">@LocalizedUiText.Get("Return to discovery")</a>
                    </section>
                }
                else if (_offering is not null)
                {
                    @if (_state == StaleState)
                    {
                        <section class="srs-subject-details__state srs-subject-details__state--stale"
                                 role="status"
                                 aria-live="polite">
                            <h2>@LocalizedUiText.Get("Group availability changed")</h2>
                            <p><strong>@_reasonCode</strong></p>
                            <p>
                                @LocalizedUiText.Get("This is the latest server result. No seat was reserved and no plan change was made.")
                            </p>
                            <button type="button"
                                    disabled="@_requestLoading"
                                    @onclick="LoadDetailsAsync">
                                @LocalizedUiText.Get("Refresh subject details")
                            </button>
                            <a href="/student/subjects">@LocalizedUiText.Get("Choose another subject")</a>
                        </section>
                    }

                    <section class="srs-subject-details__decision"
                             aria-labelledby="subject-decision-heading">
                        <h2 id="subject-decision-heading">@LocalizedUiText.Get("Eligibility result")</h2>
                        <StatusBadge Text="@(_offering.Eligible ? LocalizedUiText.Get("Eligible") : LocalizedUiText.Get("Unavailable"))"
                                     Icon="@(_offering.Eligible ? "✓" : "✕")"
                                     Tone="@(_offering.Eligible
                                         ? StatusBadge.BadgeTone.Success
                                         : StatusBadge.BadgeTone.Danger)" />
                        <p>
                            @LocalizedUiText.Get("Continue links record only a group intent. The schedule page and later submission must revalidate authoritative state.")
                        </p>
                    </section>

                    <EligibilityPresentation Offering="@_offering"
                                             IdPrefix="subject-detail"
                                             ShowSelectionActions="true" />
                }
            </div>
        </ChildContent>
    </AppShell>
}
else
{
    <main class="srs-subject-details srs-subject-details__standalone"
          id="main-content"
          data-route-id="STU-03"
          data-state="@_state"
          data-contract-state="@ContractState"
          tabindex="-1">
        <h1>@LocalizedUiText.Get("Subject details")</h1>
        <section role="alert" aria-live="assertive">
            <h2>@FailureHeading</h2>
            <p><strong>@_reasonCode</strong></p>
            <p>@_safeMessage</p>
            @if (!string.IsNullOrWhiteSpace(_referenceId))
            {
                <p>@LocalizedUiText.Get("Reference:") @_referenceId</p>
            }
            <a href="/student/subjects">@LocalizedUiText.Get("Return to discovery")</a>
        </section>
    </main>
}

@code {
    private const string LoadingState = "loading";
    private const string SuccessState = "success";
    private const string ValidationErrorState = "validation-error";
    private const string ServiceErrorState = "service-error";
    private const string UnauthorizedState = "unauthorized";
    private const string SessionExpiredState = "session-expired";
    private const string StaleState = "stale";
    private const string OfflineState = "offline";

    private static readonly IReadOnlyList<RoleNavigation.NavigationItem> StudentNavigation =
    [
        new(LocalizedUiText.Get("Dashboard"), "/student"),
        new(LocalizedUiText.Get("Available subjects"), "/student/subjects", IsActive: true),
        new(LocalizedUiText.Get("Current plan"), "/student/schedule")
    ];

    [Parameter]
    public Guid OfferingId { get; set; }

    private FrontendAppContextView? _shellContext;
    private OfferingEligibilityDto? _offering;
    private string _state = LoadingState;
    private string _reasonCode = "DISCOVERY_UNAVAILABLE";
    private string _safeMessage = LocalizedUiText.Get("Subject details could not be loaded.");
    private string? _referenceId;
    private bool _initialLoading = true;
    private bool _requestLoading;

    private bool IsFailureState => _state is
        ValidationErrorState or ServiceErrorState or UnauthorizedState
        or SessionExpiredState or OfflineState
        || (_state == StaleState && _offering is null);

    private string ContractState => _state switch
    {
        LoadingState => "STU-03-COMP-STATE-LOADING",
        SuccessState => "STU-03-COMP-STATE-SUCCESS",
        ValidationErrorState => "STU-03-COMP-STATE-VALIDATION-ERROR",
        ServiceErrorState => "STU-03-COMP-STATE-SERVICE-ERROR",
        UnauthorizedState => "STU-03-COMP-STATE-UNAUTHORIZED",
        SessionExpiredState => "STU-03-COMP-STATE-SESSION-EXPIRED",
        StaleState => "STU-03-COMP-STATE-STALE",
        OfflineState => "STU-03-COMP-STATE-OFFLINE",
        _ => "STU-03-COMP-STATE-SERVICE-ERROR"
    };

    private string FailureHeading => _state switch
    {
        ValidationErrorState => LocalizedUiText.Get("Subject is not available in this context"),
        UnauthorizedState => LocalizedUiText.Get("Access denied"),
        SessionExpiredState => LocalizedUiText.Get("Session expired"),
        StaleState => LocalizedUiText.Get("Group availability changed"),
        OfflineState => LocalizedUiText.Get("Subject details are offline"),
        _ => LocalizedUiText.Get("Subject details are unavailable")
    };

    protected override async Task OnParametersSetAsync()
    {
        if (OfferingId == Guid.Empty)
        {
            _initialLoading = false;
            _state = ValidationErrorState;
            _reasonCode = "OFFERING_NOT_FOUND_OR_OUTSIDE_CONTEXT";
            _safeMessage = LocalizedUiText.Get("The requested subject identifier is not valid.");
            return;
        }

        try
        {
            var contextResult = await AcademicApi.GetAppContextAsync();
            if (!contextResult.IsSuccess || contextResult.Value is null)
            {
                ApplyFailure(contextResult.StatusCode, contextResult.Error);
                return;
            }

            var context = contextResult.Value;
            if (!RegistrationPageSupport.IsStudentContext(context))
            {
                ApplyFailure(
                    HttpStatusCode.Forbidden,
                    new ApiError(
                        "FORBIDDEN",
                        LocalizedUiText.Get("The active server role cannot open Student subject details."),
                        "STU-03-AUTHORIZATION"));
                return;
            }

            _shellContext = RegistrationPageSupport.ToShellContext(context);
            if (context.ServiceState is not ServiceState.Available)
            {
                ApplyFailure(
                    HttpStatusCode.ServiceUnavailable,
                    new ApiError(
                        context.ServiceState is ServiceState.Maintenance
                            ? "MAINTENANCE"
                            : "DISCOVERY_UNAVAILABLE",
                        LocalizedUiText.Get("Subject details are temporarily unavailable."),
                        "STU-03-SERVICE"));
                return;
            }

            await LoadDetailsAsync();
        }
        catch (HttpRequestException)
        {
            _state = OfflineState;
            _reasonCode = "OFFLINE";
            _safeMessage = LocalizedUiText.Get("The browser cannot reach subject details. No request was queued.");
            _offering = null;
        }
        finally
        {
            _initialLoading = false;
        }
    }

    private async Task LoadDetailsAsync()
    {
        _requestLoading = true;
        _offering = null;
        _referenceId = null;
        try
        {
            var result = await RegistrationApi.GetEligibilityAsync(OfferingId);
            if (!result.IsSuccess || result.Value is null)
            {
                ApplyFailure(result.StatusCode, result.Error);
                return;
            }

            _offering = result.Value;
            var staleReason = result.Value.Groups
                .SelectMany(group => group.NonSelectableReasons)
                .FirstOrDefault(reason => reason.Code is "GROUP_FULL" or "GROUP_CHANGED");
            if (staleReason is not null)
            {
                _state = StaleState;
                _reasonCode = staleReason.Code;
                _safeMessage = staleReason.Message;
            }
            else
            {
                _state = SuccessState;
                _reasonCode = result.Value.Eligible ? "AVAILABLE" : "UNAVAILABLE";
                _safeMessage = string.Empty;
            }
        }
        catch (HttpRequestException)
        {
            _state = OfflineState;
            _reasonCode = "OFFLINE";
            _safeMessage = LocalizedUiText.Get("The browser cannot reach subject details. No request was queued.");
            _offering = null;
        }
        finally
        {
            _requestLoading = false;
        }
    }

    private void ApplyFailure(HttpStatusCode statusCode, ApiError? error)
    {
        _offering = null;
        _reasonCode = error?.Code ?? "DISCOVERY_UNAVAILABLE";
        _safeMessage = error?.Message ?? LocalizedUiText.Get("The request could not be completed safely.");
        _referenceId = error?.CorrelationId;
        _state = _reasonCode switch
        {
            "GROUP_FULL" or "GROUP_CHANGED" or "WINDOW_CHANGED" or "STALE_VERSION" =>
                StaleState,
            "SESSION_EXPIRED" => SessionExpiredState,
            _ when statusCode is HttpStatusCode.Unauthorized => SessionExpiredState,
            _ when statusCode is HttpStatusCode.Forbidden => UnauthorizedState,
            _ when statusCode is HttpStatusCode.NotFound => ValidationErrorState,
            _ => ServiceErrorState
        };
    }

    private static string Credits(decimal value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);
}
