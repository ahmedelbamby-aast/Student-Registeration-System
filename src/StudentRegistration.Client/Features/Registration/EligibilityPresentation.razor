@using System.Globalization
@using StudentRegistration.Client.Components.Feedback
@using StudentRegistration.Client.Components.Registration
@using StudentRegistration.Contracts.Registration

<section class="srs-eligibility" aria-label="@($"{Offering.CourseCode} eligibility details")">
    <div class="srs-eligibility__load" aria-labelledby="@($"{IdPrefix}-load-heading")">
        <h3 id="@($"{IdPrefix}-load-heading")">@LocalizedUiText.Get("Credit load")</h3>
        <dl>
            <div>
                <dt>@LocalizedUiText.Get("Current plan")</dt>
                <dd>@Credits(Offering.CurrentPlanCredits) @LocalizedUiText.Get("of") @Credits(Offering.MaximumAllowedCredits) @LocalizedUiText.Get("credits")</dd>
            </div>
            <div>
                <dt>@LocalizedUiText.Get("Projected with this subject")</dt>
                <dd>@Credits(Offering.ProjectedPlanCredits) @LocalizedUiText.Get("of") @Credits(Offering.MaximumAllowedCredits) @LocalizedUiText.Get("credits")</dd>
            </div>
            <div>
                <dt>@LocalizedUiText.Get("Default target")</dt>
                <dd>@Credits(Offering.DefaultTargetCredits) @LocalizedUiText.Get("credits")</dd>
            </div>
            <div>
                <dt>@LocalizedUiText.Get("Effective maximum")</dt>
                <dd>@Credits(Offering.MaximumAllowedCredits) @LocalizedUiText.Get("credits")</dd>
            </div>
        </dl>
    </div>

    <section class="srs-eligibility__reasons"
             aria-labelledby="@($"{IdPrefix}-reasons-heading")">
        <h3 id="@($"{IdPrefix}-reasons-heading")">@LocalizedUiText.Get("Server eligibility reasons")</h3>
        <ul>
            @foreach (var reason in Offering.Reasons)
            {
                <li data-reason-code="@reason.Code">
                    <div class="srs-eligibility__reason-heading">
                        <StatusBadge Text="@(reason.Passed ? LocalizedUiText.Get("Passed") : LocalizedUiText.Get("Unavailable"))"
                                     Icon="@(reason.Passed ? "✓" : "✕")"
                                     Tone="@(reason.Passed
                                         ? StatusBadge.BadgeTone.Success
                                         : StatusBadge.BadgeTone.Danger)" />
                        <strong>@reason.Code</strong>
                    </div>
                    <p>@reason.Message</p>
                    @if (reason.RequiredValue is not null || reason.CurrentValue is not null)
                    {
                        <dl>
                            @if (reason.RequiredValue is not null)
                            {
                                <div>
                                    <dt>@LocalizedUiText.Get("Required")</dt>
                                    <dd>@reason.RequiredValue</dd>
                                </div>
                            }
                            @if (reason.CurrentValue is not null)
                            {
                                <div>
                                    <dt>@LocalizedUiText.Get("Current")</dt>
                                    <dd>@reason.CurrentValue</dd>
                                </div>
                            }
                        </dl>
                    }
                    <p>
                        @LocalizedUiText.Get("Policy") <strong>@reason.PolicyVersion</strong>@LocalizedUiText.Get("; source") <span>@reason.SourceReference</span>@LocalizedUiText.Get("; accessed") <time datetime="@reason.SourceAccessedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                            @reason.SourceAccessedOn.ToString("d", CultureInfo.CurrentCulture)
                        </time>@LocalizedUiText.Get("; approved by") <span>@reason.ApprovedBy</span>.
                    </p>
                    <p>
                        @LocalizedUiText.Get("Effective")
                        <time datetime="@reason.EffectiveFromUtc.ToString("O", CultureInfo.InvariantCulture)">
                            @reason.EffectiveFromUtc.ToString("d", CultureInfo.CurrentCulture)
                        </time>
                        @if (reason.EffectiveToUtc is { } effectiveTo)
                        {
                            <span> @LocalizedUiText.Get("to") </span>
                            <time datetime="@effectiveTo.ToString("O", CultureInfo.InvariantCulture)">
                                @effectiveTo.ToString("d", CultureInfo.CurrentCulture)
                            </time>
                        }
                        <span>@LocalizedUiText.Get("; override possible:") @(reason.OverridePossible ? LocalizedUiText.Get("yes") : LocalizedUiText.Get("no")).</span>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(reason.SupportReferencePath))
                    {
                        <a href="@reason.SupportReferencePath">@LocalizedUiText.Get("Open reason support")</a>
                    }
                </li>
            }
        </ul>
    </section>

    <section class="srs-eligibility__groups"
             aria-labelledby="@($"{IdPrefix}-groups-heading")">
        <h3 id="@($"{IdPrefix}-groups-heading")">@LocalizedUiText.Get("Groups")</h3>
        <div class="srs-eligibility__group-grid">
            @foreach (var group in Offering.Groups)
            {
                <article class="srs-eligibility__group"
                         data-group-id="@group.GroupId"
                         data-selectable="@group.Selectable.ToString().ToLowerInvariant()">
                    <header>
                        <h4>@LocalizedUiText.Get("Group") @group.GroupCode</h4>
                        <StatusBadge Text="@(group.Selectable ? LocalizedUiText.Get("Selectable") : LocalizedUiText.Get("Unavailable"))"
                                     Icon="@(group.Selectable ? "✓" : "✕")"
                                     Tone="@(group.Selectable
                                         ? StatusBadge.BadgeTone.Success
                                         : StatusBadge.BadgeTone.Danger)" />
                    </header>
                    <p>@LocalizedUiText.Get("Lifecycle state:") <strong>@group.State</strong></p>
                    <CapacityBreakdown AccessibleName="@($"Group {group.GroupCode} capacity")"
                                       State="@(group.SeatsRemaining == 0 ? CapacityBreakdown.CapacityState.Full : CapacityBreakdown.CapacityState.Current)"
                                       StateMessage="@(group.SeatsRemaining == 0 ? LocalizedUiText.Get("This group is full.") : LocalizedUiText.Get("Current server-authoritative capacity."))"
                                       TotalLabel="@(LocalizedUiText.Get("Total"))"
                                       Total="@group.Capacity"
                                       EnrolledLabel="@(LocalizedUiText.Get("Enrolled"))"
                                       Enrolled="@group.EnrolledCount"
                                       HeldLabel="@(LocalizedUiText.Get("Held"))"
                                       Held="@group.HeldSeatCount"
                                       AvailableLabel="@(LocalizedUiText.Get("Available"))"
                                       Available="@group.SeatsRemaining" />

                    @if (group.NonSelectableReasons.Count > 0)
                    {
                        <ul class="srs-eligibility__group-reasons">
                            @foreach (var reason in group.NonSelectableReasons)
                            {
                                <li data-reason-code="@reason.Code">
                                    <strong>@reason.Code</strong>
                                    <span>@reason.Message</span>
                                </li>
                            }
                        </ul>
                    }

                    <div class="srs-eligibility__meetings">
                        @foreach (var meeting in group.Meetings)
                        {
                            <section aria-label="@($"{meeting.Activity} meeting")">
                                <h5>@meeting.Activity</h5>
                                <dl>
                                    <div>
                                        <dt>@LocalizedUiText.Get("Day")</dt>
                                        <dd>@RegistrationPageSupport.DayName(meeting.DayOfWeek)</dd>
                                    </div>
                                    <div>
                                        <dt>@LocalizedUiText.Get("Time")</dt>
                                        <dd>@meeting.StartLocal.ToString("t", CultureInfo.CurrentCulture)–@meeting.EndLocal.ToString("t", CultureInfo.CurrentCulture)</dd>
                                    </div>
                                    <div>
                                        <dt>@LocalizedUiText.Get("Room")</dt>
                                        <dd>@meeting.RoomCode</dd>
                                    </div>
                                    <div>
                                        <dt>@LocalizedUiText.Get("Location")</dt>
                                        <dd>@meeting.Location</dd>
                                    </div>
                                </dl>
                                <ul aria-label="@($"{meeting.Activity} staff")">
                                    @foreach (var staff in meeting.Staff)
                                    {
                                        <li><span>@staff.Role</span>: <strong>@staff.Name</strong></li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>

                    <p class="srs-eligibility__version">@LocalizedUiText.Get("Group version:") @group.RowVersion</p>
                    @if (ShowSelectionActions && group.Selectable && Offering.Eligible)
                    {
                        <a class="srs-eligibility__primary-action"
                           href="@($"/student/schedule?offeringId={Offering.OfferingId:D}&groupId={group.GroupId:D}")">
                            @LocalizedUiText.Get("Continue with group") @group.GroupCode
                        </a>
                    }
                </article>
            }
        </div>
    </section>

    <details class="srs-eligibility__versions">
        <summary>@LocalizedUiText.Get("Decision versions and input summary")</summary>
        <dl>
            <div><dt>@LocalizedUiText.Get("Evaluated")</dt><dd>@Offering.EvaluatedAtUtc.ToString("g", CultureInfo.CurrentCulture)</dd></div>
            <div><dt>@LocalizedUiText.Get("Academic context")</dt><dd>@Offering.AcademicContextVersion</dd></div>
            <div><dt>@LocalizedUiText.Get("Catalogue")</dt><dd>@Offering.CatalogueVersion</dd></div>
            <div><dt>@LocalizedUiText.Get("Policy")</dt><dd>@Offering.PolicyVersion</dd></div>
            <div><dt>@LocalizedUiText.Get("Offering")</dt><dd>@Offering.OfferingRowVersion</dd></div>
            <div><dt>@LocalizedUiText.Get("Current plan")</dt><dd>@Offering.CurrentPlanVersion</dd></div>
            @foreach (var item in Offering.InputSummary)
            {
                <div><dt>@item.Key</dt><dd>@item.Value</dd></div>
            }
        </dl>
    </details>
</section>

@code {
    [Parameter, EditorRequired]
    public OfferingEligibilityDto Offering { get; set; } = null!;

    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public bool ShowSelectionActions { get; set; }

    private static string Credits(decimal value) =>
        value.ToString("0.##", CultureInfo.CurrentCulture);
}
