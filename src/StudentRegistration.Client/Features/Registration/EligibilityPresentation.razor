@using System.Globalization
@using StudentRegistration.Client.Components.Feedback
@using StudentRegistration.Client.Components.Registration
@using StudentRegistration.Contracts.Registration

<section class="srs-eligibility" aria-label="@($"{Offering.CourseCode} eligibility details")">
    <div class="srs-eligibility__load" aria-labelledby="@($"{IdPrefix}-load-heading")">
        <h3 id="@($"{IdPrefix}-load-heading")">Credit load</h3>
        <dl>
            <div>
                <dt>Current plan</dt>
                <dd>@Credits(Offering.CurrentPlanCredits) of @Credits(Offering.MaximumAllowedCredits) credits</dd>
            </div>
            <div>
                <dt>Projected with this subject</dt>
                <dd>@Credits(Offering.ProjectedPlanCredits) of @Credits(Offering.MaximumAllowedCredits) credits</dd>
            </div>
            <div>
                <dt>Default target</dt>
                <dd>@Credits(Offering.DefaultTargetCredits) credits</dd>
            </div>
            <div>
                <dt>Effective maximum</dt>
                <dd>@Credits(Offering.MaximumAllowedCredits) credits</dd>
            </div>
        </dl>
    </div>

    <section class="srs-eligibility__reasons"
             aria-labelledby="@($"{IdPrefix}-reasons-heading")">
        <h3 id="@($"{IdPrefix}-reasons-heading")">Server eligibility reasons</h3>
        <ul>
            @foreach (var reason in Offering.Reasons)
            {
                <li data-reason-code="@reason.Code">
                    <div class="srs-eligibility__reason-heading">
                        <StatusBadge Text="@(reason.Passed ? "Passed" : "Unavailable")"
                                     Icon="@(reason.Passed ? "✓" : "✕")"
                                     Tone="@(reason.Passed
                                         ? StatusBadge.BadgeTone.Success
                                         : StatusBadge.BadgeTone.Danger)" />
                        <strong>@reason.Code</strong>
                    </div>
                    <p>@reason.Message</p>
                    @if (reason.RequiredValue is not null || reason.CurrentValue is not null)
                    {
                        <dl>
                            @if (reason.RequiredValue is not null)
                            {
                                <div>
                                    <dt>Required</dt>
                                    <dd>@reason.RequiredValue</dd>
                                </div>
                            }
                            @if (reason.CurrentValue is not null)
                            {
                                <div>
                                    <dt>Current</dt>
                                    <dd>@reason.CurrentValue</dd>
                                </div>
                            }
                        </dl>
                    }
                    <p>
                        Policy <strong>@reason.PolicyVersion</strong>;
                        source <span>@reason.SourceReference</span>;
                        accessed <time datetime="@reason.SourceAccessedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                            @reason.SourceAccessedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        </time>;
                        approved by <span>@reason.ApprovedBy</span>.
                    </p>
                    <p>
                        Effective
                        <time datetime="@reason.EffectiveFromUtc.ToString("O", CultureInfo.InvariantCulture)">
                            @reason.EffectiveFromUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        </time>
                        @if (reason.EffectiveToUtc is { } effectiveTo)
                        {
                            <span> to </span>
                            <time datetime="@effectiveTo.ToString("O", CultureInfo.InvariantCulture)">
                                @effectiveTo.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                            </time>
                        }
                        <span>; override possible: @(reason.OverridePossible ? "yes" : "no").</span>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(reason.SupportReferencePath))
                    {
                        <a href="@reason.SupportReferencePath">Open reason support</a>
                    }
                </li>
            }
        </ul>
    </section>

    <section class="srs-eligibility__groups"
             aria-labelledby="@($"{IdPrefix}-groups-heading")">
        <h3 id="@($"{IdPrefix}-groups-heading")">Groups</h3>
        <div class="srs-eligibility__group-grid">
            @foreach (var group in Offering.Groups)
            {
                <article class="srs-eligibility__group"
                         data-group-id="@group.GroupId"
                         data-selectable="@group.Selectable.ToString().ToLowerInvariant()">
                    <header>
                        <h4>Group @group.GroupCode</h4>
                        <StatusBadge Text="@(group.Selectable ? "Selectable" : "Unavailable")"
                                     Icon="@(group.Selectable ? "✓" : "✕")"
                                     Tone="@(group.Selectable
                                         ? StatusBadge.BadgeTone.Success
                                         : StatusBadge.BadgeTone.Danger)" />
                    </header>
                    <p>Lifecycle state: <strong>@group.State</strong></p>
                    <CapacityIndicator AccessibleName="@($"Group {group.GroupCode} capacity")"
                                       OccupiedLabel="Occupied"
                                       Occupied="@group.EnrolledCount"
                                       TotalLabel="Capacity"
                                       Total="@group.Capacity"
                                       RemainingLabel="Remaining"
                                       Remaining="@group.SeatsRemaining" />

                    @if (group.NonSelectableReasons.Count > 0)
                    {
                        <ul class="srs-eligibility__group-reasons">
                            @foreach (var reason in group.NonSelectableReasons)
                            {
                                <li data-reason-code="@reason.Code">
                                    <strong>@reason.Code</strong>
                                    <span>@reason.Message</span>
                                </li>
                            }
                        </ul>
                    }

                    <div class="srs-eligibility__meetings">
                        @foreach (var meeting in group.Meetings)
                        {
                            <section aria-label="@($"{meeting.Activity} meeting")">
                                <h5>@meeting.Activity</h5>
                                <dl>
                                    <div>
                                        <dt>Day</dt>
                                        <dd>@RegistrationPageSupport.DayName(meeting.DayOfWeek)</dd>
                                    </div>
                                    <div>
                                        <dt>Time</dt>
                                        <dd>@meeting.StartLocal.ToString("HH:mm", CultureInfo.InvariantCulture)–@meeting.EndLocal.ToString("HH:mm", CultureInfo.InvariantCulture)</dd>
                                    </div>
                                    <div>
                                        <dt>Room</dt>
                                        <dd>@meeting.RoomCode</dd>
                                    </div>
                                    <div>
                                        <dt>Location</dt>
                                        <dd>@meeting.Location</dd>
                                    </div>
                                </dl>
                                <ul aria-label="@($"{meeting.Activity} staff")">
                                    @foreach (var staff in meeting.Staff)
                                    {
                                        <li><span>@staff.Role</span>: <strong>@staff.Name</strong></li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>

                    <p class="srs-eligibility__version">Group version: @group.RowVersion</p>
                    @if (ShowSelectionActions && group.Selectable && Offering.Eligible)
                    {
                        <a class="srs-eligibility__primary-action"
                           href="@($"/student/schedule?offeringId={Offering.OfferingId:D}&groupId={group.GroupId:D}")">
                            Continue with group @group.GroupCode
                        </a>
                    }
                </article>
            }
        </div>
    </section>

    <details class="srs-eligibility__versions">
        <summary>Decision versions and input summary</summary>
        <dl>
            <div><dt>Evaluated</dt><dd>@Offering.EvaluatedAtUtc.ToString("u", CultureInfo.InvariantCulture)</dd></div>
            <div><dt>Academic context</dt><dd>@Offering.AcademicContextVersion</dd></div>
            <div><dt>Catalogue</dt><dd>@Offering.CatalogueVersion</dd></div>
            <div><dt>Policy</dt><dd>@Offering.PolicyVersion</dd></div>
            <div><dt>Offering</dt><dd>@Offering.OfferingRowVersion</dd></div>
            <div><dt>Current plan</dt><dd>@Offering.CurrentPlanVersion</dd></div>
            @foreach (var item in Offering.InputSummary)
            {
                <div><dt>@item.Key</dt><dd>@item.Value</dd></div>
            }
        </dl>
    </details>
</section>

@code {
    [Parameter, EditorRequired]
    public OfferingEligibilityDto Offering { get; set; } = null!;

    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public bool ShowSelectionActions { get; set; }

    private static string Credits(decimal value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);
}
