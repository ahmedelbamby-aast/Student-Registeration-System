{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-registration.demo/schemas/api-error/1.0",
  "title": "SPEC-006 ApiError",
  "description": "Closed privacy-safe API error response contract.",
  "x-owner-spec": "SPEC-006",
  "x-schema-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "correlationId"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "description": "Stable machine-readable error code."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Privacy-safe actionable message."
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "Request correlation reference for authorized support."
    },
    "fieldErrors": {
      "type": "object",
      "description": "Optional field-keyed validation details.",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "currentVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Optional current version disclosed only to an authorized caller."
    }
  }
}
