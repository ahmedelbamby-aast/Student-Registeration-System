{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-registration.demo/schemas/page/1.0",
  "title": "SPEC-006 Page",
  "description": "Closed bounded page-number listing response contract.",
  "x-owner-spec": "SPEC-006",
  "x-schema-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "page",
    "pageSize",
    "totalCount",
    "sort"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "description": "Items projected by the owning feature contract.",
      "items": {}
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0
    },
    "sort": {
      "type": "string",
      "minLength": 1,
      "description": "Echoes the applied canonical sort, including its unique identifier tie-breaker."
    }
  }
}
