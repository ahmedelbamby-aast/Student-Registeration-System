{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-registration.demo/schemas/release-evidence/1.0",
  "title": "SPEC-018 ReleaseEvidence",
  "x-owner-spec": "SPEC-018",
  "x-schema-version": "1.0",
  "x-immutable-after-signoff": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerSpec",
    "scope",
    "evidenceId",
    "evidenceVersion",
    "releaseCandidate",
    "sourceCommit",
    "recordedAtUtc",
    "status",
    "gates",
    "approvals",
    "productionAuthorized",
    "officialAastmtApproval"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ownerSpec": { "const": "SPEC-018" },
    "scope": { "const": "non-production-demo" },
    "evidenceId": {
      "type": "string",
      "pattern": "^release-evidence-[a-z0-9-]+$",
      "maxLength": 100
    },
    "evidenceVersion": { "type": "integer", "minimum": 1 },
    "releaseCandidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "recordedAtUtc": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/gate" }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/approval" }
    },
    "productionAuthorized": { "const": false },
    "officialAastmtApproval": { "const": false }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "category",
        "status",
        "evidenceRefs",
        "blockingReasons"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "code",
            "architecture",
            "data",
            "security",
            "accessibility",
            "load",
            "recovery",
            "operations",
            "product"
          ]
        },
        "status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(docs|tests|ops)/",
            "maxLength": 240
          }
        },
        "blockingReasons": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perspective", "decision", "reviewedBy", "recordedAtUtc"],
      "properties": {
        "perspective": {
          "type": "string",
          "enum": [
            "engineering",
            "product-owner",
            "domain-owner",
            "qa",
            "security",
            "accessibility",
            "data-concurrency",
            "operations"
          ]
        },
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "pending"]
        },
        "reviewedBy": { "const": "Ahmed ELbamby" },
        "recordedAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "pass" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "gates": {
            "minItems": 9,
            "allOf": [
              {
                "contains": {
                  "properties": { "category": { "const": "code" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "architecture" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "data" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "security" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "accessibility" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "load" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "recovery" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "operations" } },
                  "required": ["category"]
                }
              },
              {
                "contains": {
                  "properties": { "category": { "const": "product" } },
                  "required": ["category"]
                }
              }
            ],
            "items": {
              "properties": {
                "status": { "const": "pass" },
                "blockingReasons": { "maxItems": 0 }
              },
              "required": ["status", "blockingReasons"]
            }
          },
          "approvals": {
            "minItems": 7,
            "allOf": [
              {
                "contains": {
                  "properties": { "perspective": { "const": "product-owner" } },
                  "required": ["perspective"]
                }
              },
              {
                "contains": {
                  "properties": { "perspective": { "const": "domain-owner" } },
                  "required": ["perspective"]
                }
              },
              {
                "contains": {
                  "properties": { "perspective": { "const": "qa" } },
                  "required": ["perspective"]
                }
              },
              {
                "contains": {
                  "properties": { "perspective": { "const": "security" } },
                  "required": ["perspective"]
                }
              },
              {
                "contains": {
                  "properties": { "perspective": { "const": "accessibility" } },
                  "required": ["perspective"]
                }
              },
              {
                "contains": {
                  "properties": { "perspective": { "const": "data-concurrency" } },
                  "required": ["perspective"]
                }
              },
              {
                "contains": {
                  "properties": { "perspective": { "const": "operations" } },
                  "required": ["perspective"]
                }
              }
            ],
            "items": {
              "properties": {
                "decision": { "const": "approved" }
              },
              "required": ["decision"]
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "schemaVersion": "1.0",
      "ownerSpec": "SPEC-018",
      "scope": "non-production-demo",
      "evidenceId": "release-evidence-20260714-01",
      "evidenceVersion": 1,
      "releaseCandidate": "demo-2026.07.14-rc1",
      "sourceCommit": "0000000000000000000000000000000000000000",
      "recordedAtUtc": "2026-07-14T02:15:00Z",
      "status": "blocked",
      "gates": [
        {
          "gateId": "non-production-scope",
          "category": "product",
          "status": "blocked",
          "evidenceRefs": ["docs/PROJECT_PLAN.md"],
          "blockingReasons": [
            "The demo evidence does not authorize a production or institutional release."
          ]
        }
      ],
      "approvals": [
        {
          "perspective": "engineering",
          "decision": "approved",
          "reviewedBy": "Ahmed ELbamby",
          "recordedAtUtc": "2026-07-14T02:15:00Z"
        }
      ],
      "productionAuthorized": false,
      "officialAastmtApproval": false
    }
  ]
}
